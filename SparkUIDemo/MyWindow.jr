resource MenuEditorJson "MenuEditor.json";
resource ShortcutEditorJson "ShortcutEditor.json";

int WinStart(long hInstance, long hPrevInstance, byte *pstrCommandLine, int nCmdShow)
{
    RTTIModule module = RTTIModule.GetModule("SparkUIDemo");
    array<string> names = module.EnumResources();

    Log(names.join(", "));

    RTTIResourceEntry *res = module.GetResource("MenuEditorJson");
    if(res != null)
    {
        string json = new string(res.data);
    }

    RTTIClassType cls = RTTIType.GetType("Listbox") as RTTIClassType;
    array<string> props = cls.EnumAllProperties();

    Log(props.join(", "));

    array<string> fields = cls.EnumAllFields();
    Log(fields.join(", "));

    Window window = new MyWindow();
    window.width = 1280;
    window.height = 720;

    window.Show(SW_NORMAL);

    return Application.Run();
}

