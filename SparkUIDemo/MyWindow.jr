    void EditMenuClicked(object sender, void *param)
    {
        MenuItem item = sender as MenuItem;
        item.Checked = true;
        MessageBox.Show(item.Text, "Edit", 0);
    }

    void Open_Clicked(object sender, void *args)
    {
        OpenFileDialog ofd = new OpenFileDialog();
        ofd.FileName = "*.txt";
        ofd.Filter = "All Files|*.*|Text Files|*.txt";
        ofd.Title = "Open a text file";
        if(ofd.Show(this))
        {
            MessageBox.Show(ofd.FileName, "Selected file", 0);
        }
        else
        {
            MessageBox.Show("Open cancelled", "Info", 0);
        }
    }

    void Save_Clicked(object sender, void *args)
    {
        SaveFileDialog sfd = new SaveFileDialog();
        sfd.FileName = "Untitled.txt";
        sfd.Filter = "All Files|*.*|Text Files|*.txt";
        sfd.Title = "Save a text file";
        sfd.DefaultExtension = "txt";
        if(sfd.Show(this))
        {
            MessageBox.Show(sfd.FileName, "Save to file", 0);
        }
        else
        {
            MessageBox.Show("Save cancelled", "Info", 0);
        }
    }

    void Exit_Clicked(object sender, void *args)
    {
        if(MessageBox.Show("Are you sure you want to exit?", "SparkUI", MsgFlags.Question | MsgFlags.YesNo) == 1)
        {
            Application.Exit(99);
        }
    }

    void Button1_Clicked(object sender, void* args)
    {
        MessageBox.Show("Button1 Clicked!", "Info", 0);
    }

    void Button2_Clicked(object sender, void* args)
    {
        button1.Enabled = !button1.Enabled;
        checkbox1.Enabled = !checkbox1.Enabled;
        radio1.Enabled = !radio1.Enabled;
        listbox.Enabled = !listbox.Enabled;
    }

    void Button3_Clicked(object sender, void* args)
    {
        button1.Visible = !button1.Visible;
        checkbox1.Visible = !checkbox1.Visible;
        radio1.Visible = !radio1.Visible;
        listbox.Visible = !listbox.Visible;
    }

    void OnDestroy()
    {
        Application.Exit(0);
    }

