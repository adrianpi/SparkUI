enum TestEnum
{
    Zero,
    One,
    Two,
    Three,
    Four
}

class SubSubTestClass
{
    int intValue = 11;
    float floatValue = 3.33;
    int get IntValue() => intValue;
    void set IntValue(int value) => intValue = value;
    float get FloatValue() => floatValue;
    void set FloatValue(float value) => floatValue = value;
}

class SubTestClass
{
    int intValue = 88;
    float floatValue = 6.28;
    SubSubTestClass subSubObject = new SubSubTestClass();
    int get IntValue() => intValue;
    void set IntValue(int value) => intValue = value;
    float get FloatValue() => floatValue;
    void set FloatValue(float value) => floatValue = value;
    SubSubTestClass get SubSubObject() => subSubObject;
    void set SubSubObject(SubSubTestClass value) => subSubObject = value;
}

struct Point
{
    int x;
    int y;
}

struct Composite
{
    int index;
    Point pt;
}

class Collectable
{
    string name;
    int age;

    string get Name() => name;
    void set Name(string value) => name = value;

    int get Age() => age;
    void set Age(int value) => age = value;
}

class Collectable2 : Collectable
{
    string description;
    string get Description() => description;
    void set Description(string value) => description = value;
}

class TestClass
{
    int intValue = 42;
    float floatValue = 3.14;
    string stringValue = "Hello, world!";
    bool boolValue = true;
    TestEnum enumValue = TestEnum.Zero;
    double doubleValue = 2.71828;
    byte byteValue = 99;
    ubyte ubyteValue = 101;
    uint color = 0x0000ff;
    Bitmap bitmap = null;
    string fileName = null;
    Point position;
    Composite composite;
    array<Collectable> collectables = new array<Collectable>();
    int get IntValue() => intValue;
    void set IntValue(int value) => intValue = value;
    float get FloatValue() => floatValue;
    void set FloatValue(float value) => floatValue = value;
    [DisplayName("String Value")]
    string get StringValue() => stringValue;
    void set StringValue(string value) => stringValue = value;
    bool get BoolValue() => boolValue;
    void set BoolValue(bool value) => boolValue = value;
    TestEnum get EnumValue() => enumValue;
    void set EnumValue(TestEnum value) => enumValue = value;
    //[Browsable(false)]
    double get DoubleValue() => doubleValue;
    void set DoubleValue(double value) => doubleValue = value;
    byte get ByteValue() => byteValue;
    void set ByteValue(byte value) => byteValue = value;
    ubyte get UByteValue() => ubyteValue;
    void set UByteValue(ubyte value) => ubyteValue = value;
    SubTestClass subObject = new SubTestClass();
    SubTestClass get ASubObject() => subObject;
    void set ASubObject(SubTestClass value) => subObject = value;
    [PropertyEditor("ColorPropertyEditor")]
    uint get Color() => color;
    void set Color(uint value) => color = value;
    Bitmap get BitMap() => bitmap;
    void set BitMap(Bitmap value) => bitmap = value;
    [PropertyEditor("FilenamePropertyEditor")]
    [FilenameFilter("Jargon Files|*.jr|")]
    string get FileName() => fileName;
    void set FileName(string value) => fileName = value;
    //[PropertyEditor("PointPropertyEditor")] 
    Point get Position() => position;
    void set Position(Point value)
    {
        position = value;
    }
    Composite get CompositeValue() => composite;
    void set CompositeValue(Composite value)
    {
        composite = value;
    }
    [AcceptTypes("Collectable,Collectable2")]
    array<Collectable> get Collectables() => collectables;
}

class PointPropertyEditor : TextPropertyEditor
{
    string GetStringValue(PropertyGridValue prop)
    {
        Point value;
        prop.GetStructValue(sizeof(value), &value);
        return string.format("%d, %d", value.x, value.y);
    }

    bool SetStringValue(PropertyGridValue prop, string value)
    {
        array<string> parts = value.split(",");
        if(parts.count != 2)
            return false;
        int x, y;
        if(!parse_int(parts[0].c_str(), &x))
            return false;
        if(!parse_int(parts[1].c_str(), &y))
            return false;
        Point v = {x, y};
        prop.SetStructValue(sizeof(v), &v);
        return true;
    }
}

