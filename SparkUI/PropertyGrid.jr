using jargon;

int strtol(byte *str, byte **endptr, int _base) external;
uint strtoul(byte *str, byte **endptr, int _base) external;
long strtoll(byte *str, byte **endptr, int _base) external;
ulong strtoull(byte *str, byte **endptr, int _base) external;
float strtof(byte *str, byte **endptr) external;
double strtod(byte *str, byte **endptr) external;
void DrawIcon(long hDC, int x, int y, long hIcon) external;
void IntersectClipRect(long hdc, int left, int top, int right, int bottom) external;
int SaveDC(long hDC) external;
void RestoreDC(long hDC, int saved) external;

bool parse_byte(byte *str, byte *out)
{
    byte *end;
    int value = strtol(str, &end, 10);
    if (end == str)
        return false;
    if (*end != '\0')
        return false;
    if (value < -128 || value > 127)
        return false;
    *out = (byte)value;
    return true;
}

bool parse_ubyte(byte *str, ubyte *out)
{
    byte *end;
    uint value = strtoul(str, &end, 10);
    if (end == str)
        return false;
    if (*end != '\0')
        return false;
    if (value > 255)
        return false;
    *out = (ubyte)value;
    return true;
}

bool parse_short(byte *str, short *out)
{
    byte *end;
    int value = strtol(str, &end, 10);
    if (end == str)
        return false;
    if (*end != '\0')
        return false;
    if (value < -32768 || value > 32767)
        return false;
    *out = (short)value;
    return true;
}

bool parse_ushort(byte *str, ushort *out)
{
    byte *end;
    uint value = strtoul(str, &end, 10);
    if (end == str)
        return false;
    if (*end != '\0')
        return false;
    if (value > 65535)
        return false;
    *out = (ushort)value;
    return true;
}

bool parse_int(byte *str, int *out)
{
    byte *end;

    int value = strtol(str, &end, 10);

    if (end == str)
        return false;

    if (*end != '\0')
        return false;

    if (value < -2147483648 || value > 2147483647)
        return false;

    *out = (int)value;
    return true;
}

bool parse_uint(byte *str, uint *out)
{
    byte *end;

    uint value = strtoul(str, &end, 10);

    if (end == str)
        return false;

    if (*end != '\0')
        return false;

    if (value > 4294967295)
        return false;

    *out = (uint)value;
    return true;
}

bool parse_hex(byte *str, uint *out)
{
    byte *end;

    uint value = strtoul(str, &end, 16);

    if (end == str)
        return false;

    if (*end != '\0')
        return false;

    *out = (uint)value;
    return true;
}

bool parse_long(byte *str, long *out)
{
    byte *end;

    long value = strtoll(str, &end, 10);

    if (end == str)
        return false;

    if (*end != '\0')
        return false;

    *out = value;
    return true;
}

bool parse_ulong(byte *str, ulong *out)
{
    byte *end;

    ulong value = strtoull(str, &end, 10);

    if (end == str)
        return false;

    if (*end != '\0')
        return false;

    *out = value;
    return true;
}

bool parse_float(byte *str, float *out)
{
    byte *end;

    float value = strtof(str, &end);

    if (end == str)
        return false;

    if (*end != '\0')
        return false;

    *out = value;
    return true;
}

bool parse_double(byte *str, double *out)
{
    byte *end;

    double value = strtod(str, &end);
    if (end == str)
        return false;

    if (*end != '\0')
        return false;

    *out = value;
    return true;
}

string ftrim(string str)
{
    string temp = str;
    if(temp.indexOfChar('.') != -1)
    {
        while(temp[temp.length-1] == '0')
            temp = temp.substr(0, temp.length-1);
        if(temp[temp.length-1] == '.')
            temp = temp + '0';
    }
    return temp;
}

class PropertyEditor
{
    static dictionary<string, string> editors = new dictionary<string, string>();

    static void RegisterEditor(string typeName, string editor)
    {
        editors[typeName] = editor;
    }

    virtual string GetStringValue(PropertyGridValue prop)
    {
        return null;
    }

    virtual bool SetStringValue(PropertyGridValue prop, string value)
    {
        return false;
    }

    virtual void OnEnterEdit(PropertyGrid grid, PropertyGridValue prop, int y)
    {
    }

    virtual void OnLeaveEdit(PropertyGrid grid, PropertyGridValue prop)
    {
    }

    virtual void Draw(Canvas canvas, int x, int y, int width, int height, Font font, uint foreColor, PropertyGridValue prop)
    {
    }
}

class TextPropertyEditor : PropertyEditor
{
    static Textbox textBox;
    PropertyGrid grid;
    PropertyGridValue prop;

    void OnEnterEdit(PropertyGrid grid, PropertyGridValue prop, int y)
    {
        this.grid = grid;
        this.prop = prop;

        if(textBox == null || !IsWindow(textBox.hWnd))
        {
            textBox = new Textbox(grid, 0, 0, 100-16, 20);        
        }

        textBox.Parent = grid;
        textBox.Leave.clear();
        textBox.Leave += new Delegate(this, TextPropertyEditor.TextBox_Leave);

        textBox.SetPosition(grid.width - 100, y);
        string value = GetStringValue(prop);
        if(value == null)
            textBox.Text = "";
        else
            textBox.Text = value;
        textBox.Visible = true;
        textBox.Focus();
    }

    void OnLeaveEdit(PropertyGrid grid, PropertyGridValue prop)
    {
        textBox.Visible = false;
        string value = GetStringValue(prop);
        if(value == null)
            value = "";
        if(textBox.Text != value)
        {
            if(SetStringValue(prop, textBox.Text))
            {
                grid.Commit(prop);
            }
        }
        grid.editor = null;
    }

    void TextBox_Leave(object sender, void *args)
    {
        OnLeaveEdit(grid, prop);
    }

    void Draw(Canvas canvas, int x, int y, int width, int height, Font font, uint foreColor, PropertyGridValue prop)
    {
        string value = GetStringValue(prop);
        canvas.DrawText(x, y + 3, value, font, foreColor);
    }
}

class DropdownPropertyEditor : PropertyEditor
{
    static Dropdown dropdown;
    PropertyGrid grid;
    PropertyGridValue prop;

    virtual array<string> GetValues(RTTIProperty prop)
    {
        return null;
    }
    
    void OnEnterEdit(PropertyGrid grid, PropertyGridValue prop, int y)
    {
        this.grid = grid;
        this.prop = prop;
        if(dropdown == null)
        {
            dropdown = new Dropdown(grid, 0, 0, 100-16, 20);        
        }

        dropdown.Parent = grid;
        dropdown.Leave.clear();
        dropdown.Leave += new Delegate(this, DropdownPropertyEditor.Dropdown_Leave);

        dropdown.SetPosition(grid.width - 100, y);
        string value = GetStringValue(prop);
        dropdown.Text = value;
        dropdown.Items.Clear();
        array<string> values = GetValues(prop);
        if(values != null)
        {
            for(int i = 0; i < values.count; ++i)
            {
                dropdown.Items.Add(values[i]);
                if(value == values[i])
                    dropdown.listbox.SelectedIndex = i;
            }
        }
        dropdown.Visible = true;
        dropdown.Focus();
    }

    void OnLeaveEdit(PropertyGrid grid, PropertyGridValue prop)
    {
        dropdown.Visible = false;
        string value = GetStringValue(prop);
        if(dropdown.Text != value)
        {
            if(SetStringValue(prop, dropdown.Text))
            {
                grid.Commit(prop);
            }
        }
        grid.editor = null;
    }

    void Dropdown_Leave(object sender, void *args)
    {
        OnLeaveEdit(grid, prop);
    }

    void Draw(Canvas canvas, int x, int y, int width, int height, Font font, uint foreColor, PropertyGridValue prop)
    {
        string value = GetStringValue(prop);
        canvas.DrawText(x, y + 3, value, font, foreColor);
    }
}

class BoolPropertyEditor : DropdownPropertyEditor
{
    array<string> GetValues(PropertyGridValue prop)
    {
        array<string> result = new array<string>();
        result.add(new string("false"));
        result.add(new string("true"));
        return result;
    }
    
    string GetStringValue(PropertyGridValue prop)
    {
        bool value = prop.GetBoolValue();
        return value ? "true" : "false";
    }

    bool SetStringValue(PropertyGridValue prop, string value)
    {
        bool value = value != "false" ? true : false;
        prop.SetBoolValue(value);
        return true;
    }
}

class EnumPropertyEditor : DropdownPropertyEditor
{
    array<string> GetValues(PropertyGridValue prop)
    {
        array<string> result = new array<string>();
        RTTIEnumType enumType = prop.DataType as RTTIEnumType;
        if(enumType != null)
        {
            array<string> names = enumType.EnumValues();
            for(int i = 0; i < names.count; ++i)
            {
                result.add(names[i]);
            }
        }
        return result;
    }

    string GetStringValue(PropertyGridValue prop)
    {
        RTTIEnumType enu = prop.DataType as RTTIEnumType;

        if(enu != null)
        {
            long value = 0;
            if(enu.enumType == RTTIType.Byte || enu.enumType == RTTIType.UByte)
                value = prop.GetByteValue();
            else if(enu.enumType == RTTIType.Short || enu.enumType == RTTIType.UShort)
                value = prop.GetShortValue();
            else if(enu.enumType == RTTIType.Int || enu.enumType == RTTIType.UInt)
                value = prop.GetIntValue();
            else if(enu.enumType == RTTIType.Long || enu.enumType == RTTIType.ULong)
                value = prop.GetLongValue();

            return enu.Stringify(value);
        }
        return "";
    }

    bool SetStringValue(PropertyGridValue prop, string value)
    {
        RTTIEnumType enu = prop.DataType as RTTIEnumType;
        if(enu != null)
        {
            long intValue = enu.Parse(value);

            if(enu.enumType == RTTIType.Byte || enu.enumType == RTTIType.UByte)
                prop.SetByteValue(intValue);
            else if(enu.enumType == RTTIType.Short || enu.enumType == RTTIType.UShort)
                prop.SetShortValue(intValue);
            else if(enu.enumType == RTTIType.Int || enu.enumType == RTTIType.UInt)
                prop.SetIntValue(intValue);
            else if(enu.enumType == RTTIType.Long || enu.enumType == RTTIType.ULong)
                prop.SetLongValue(intValue);
            
            return true;
        }
        return false;
    }
}

class BytePropertyEditor : TextPropertyEditor
{
    string GetStringValue(PropertyGridValue prop)
    {
        byte value = prop.GetByteValue();
        return string.format("%d", value);
    }

    bool SetStringValue(PropertyGridValue prop, string value)
    {
        byte ivalue;
        if(!parse_byte(value.c_str(), &ivalue))
            return false;
        prop.SetByteValue(ivalue);
        return true;
    }
}

