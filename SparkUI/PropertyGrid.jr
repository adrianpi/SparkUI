class ColorPropertyEditor : PropertyEditor
{
    virtual string GetStringValue(PropertyGridValue prop)
    {
        uint value = prop.GetIntValue();
        return string.format("%6.6x", value);
    }

    virtual bool SetStringValue(PropertyGridValue prop, string value)
    {
        uint intValue;
        if(parse_hex(value.c_str(), &intValue))
        {
            prop.SetIntValue(intValue);
            return true;
        }
        return false;
    }

    static Textbox textBox = null;
    static Button button = null;
    object selectedObject = null;
    PropertyGridValue selectedProperty = null;
    PropertyGrid grid;

    void OnButtonClicked(object sender, void* args)
    {
        uint value;
        if(parse_hex(textBox.Text.c_str(), &value))
        {
            ChooseColorDialog dlg = new ChooseColorDialog();
            dlg.FullOpen = true;
            dlg.Color = value;
            if(dlg.ShowDialog(button.parent.parent))
            {
                textBox.Text = string.format("%6.6x", dlg.Color);
            }
            textBox.Visible = true;
            button.Visible = true;
            textBox.Focus();
        }
    }

    void OnEnterEdit(PropertyGrid pgrid, PropertyGridValue prop, int y)
    {
        selectedObject = prop.target;
        selectedProperty = prop;
        grid = pgrid;

        if(textBox == null)
        {
            textBox = new Textbox(pgrid, 0, 0, 99-16-19+1, 19);
            button = new Button(pgrid, 0, 0, 19, 19);
            button.Text = "...";
        }

        button.Parent = grid;
        button.Clicked.clear();
        button.Clicked += new Delegate(this, ColorPropertyEditor.OnButtonClicked);

        textBox.Parent = grid;
        textBox.Leave.clear();
        textBox.Leave += new Delegate(this, ColorPropertyEditor.OnTextBoxLeave);

        textBox.SetPosition(pgrid.width - 100, y);
        button.SetPosition(pgrid.width - 19-16, y);
        string value = GetStringValue(prop);
        textBox.Text = value;
        textBox.Visible = true;
        button.Visible = true;
        textBox.Focus();
    }

    void OnTextBoxLeave(object sender, void *args)
    {
        OnLeaveEdit(grid, selectedProperty);
    }

    void OnLeaveEdit(PropertyGrid pgrid, PropertyGridValue prop)
    {
        if(textBox != null)
        {
            textBox.Visible = false;
            button.Visible = false;
            string value = GetStringValue(prop);
            if(textBox.Text != value)
            {
                if(SetStringValue(prop, textBox.Text))
                {
                    pgrid.Commit(prop);
                }
            }
        }
    }

    void Draw(Canvas canvas, int x, int y, int width, int height, Font font, uint foreColor, PropertyGridValue prop)
    {
        uint value = prop.GetIntValue();
        Brush brush = new Brush(value);
        canvas.FillRectangle(x, y+3, width, height, brush);
    }
}

class BitmapPropertyEditor : PropertyEditor
{
    virtual string GetStringValue(PropertyGridValue prop)
    {
        return null;
    }

    virtual bool SetStringValue(PropertyGridValue prop, string value)
    {
        return true;
    }

    static Textbox textBox = null;
    static Button button = null;
    PropertyGridValue selectedProperty = null;
    PropertyGrid grid = null;

    void OnButtonClicked(object sender, void* args)
    {
        OpenFileDialog dlg = new OpenFileDialog();
        dlg.Filter = "Bitmap Files|*.bmp|All Files|*.*|";
        dlg.Title = "Select Bitmap";
        if(dlg.Show(button.parent.parent))
        {
            string fileName = dlg.FileName;
            Bitmap bmp = Bitmap.FromFile(fileName);
            selectedProperty.SetObjectValue(bmp);
            button.parent.Invalidate();
        }
        textBox.Visible = true;
        button.Visible = true;
        textBox.Focus();
    }

    void OnEnterEdit(PropertyGrid pgrid, PropertyGridValue prop, int y)
    {
        selectedProperty = prop;
        grid = pgrid;

        if(button == null)
        {
            textBox = new Textbox(pgrid, 0, 0, 0, 19);
            button = new Button(pgrid, 0, 0, 19, 19);
            button.Text = "...";
        }
        
        button.Parent = grid;
        button.Clicked.clear();
        button.Clicked += new Delegate(this, BitmapPropertyEditor.OnButtonClicked);

        textBox.Parent = grid;
        textBox.Text = "";
        textBox.Leave.clear();
        textBox.Leave += new Delegate(this, BitmapPropertyEditor.OnTextBoxLeave);

        textBox.SetPosition(pgrid.width - 100, y);
        button.SetPosition(pgrid.width - 19-16, y);
        button.Visible = true;
        textBox.Focus();
    }

    void OnTextBoxLeave(object sender, void *args)
    {
        OnLeaveEdit(grid, selectedProperty);
    }

    void OnLeaveEdit(PropertyGrid pgrid, PropertyGridValue prop)
    {
        if(textBox != null)
        {
            textBox.Visible = false;
            button.Visible = false;
        }
    }
    
    void Draw(Canvas canvas, int x, int y, int width, int height, Font font, uint foreColor, PropertyGridValue prop)
    {
        Bitmap value = prop.GetObjectValue() as Bitmap;
        if(value != null)
        {
            int w, h;
            h = height;
            w = value.width * height / value.height;
            canvas.DrawBitmap(x, y+3, w, h, value);
        }
    }
}

class IconPropertyEditor : PropertyEditor
{
    virtual string GetStringValue(PropertyGridValue prop)
    {
        return null;
    }

    virtual bool SetStringValue(PropertyGridValue prop, string value)
    {
        return true;
    }

    static Textbox textBox = null;
    static Button button = null;
    PropertyGridValue selectedProperty = null;
    PropertyGrid grid = null;

    void OnButtonClicked(object sender, void* args)
    {
        OpenFileDialog dlg = new OpenFileDialog();
        dlg.Filter = "PNG Files|*.png|All Files|*.*|";
        dlg.Title = "Select Icon";
        if(dlg.Show(button.parent.parent))
        {
            string fileName = dlg.FileName;
            Icon icon = Icon.FromFile(fileName);
            selectedProperty.SetObjectValue(icon);
            button.parent.Invalidate();
        }
        textBox.Visible = true;
        button.Visible = true;
        textBox.Focus();
    }

    void OnEnterEdit(PropertyGrid pgrid, PropertyGridValue prop, int y)
    {
        selectedProperty = prop;
        grid = pgrid;

        if(button == null)
        {
            textBox = new Textbox(pgrid, 0, 0, 0, 19);
            button = new Button(pgrid, 0, 0, 19, 19);
            button.Text = "...";
        }
        
        button.Parent = grid;
        button.Clicked.clear();
        button.Clicked += new Delegate(this, IconPropertyEditor.OnButtonClicked);

        textBox.Parent = grid;
        textBox.Text = "";
        textBox.Leave.clear();
        textBox.Leave += new Delegate(this, IconPropertyEditor.OnTextBoxLeave);

        textBox.SetPosition(pgrid.width - 100, y);
        button.SetPosition(pgrid.width - 19-16, y);
        button.Visible = true;
        textBox.Focus();
    }

    void OnTextBoxLeave(object sender, void *args)
    {
        OnLeaveEdit(grid, selectedProperty);
    }

    void OnLeaveEdit(PropertyGrid pgrid, PropertyGridValue prop)
    {
        if(textBox != null)
        {
            textBox.Visible = false;
            button.Visible = false;
        }
    }
    
    void Draw(Canvas canvas, int x, int y, int width, int height, Font font, uint foreColor, PropertyGridValue prop)
    {
        Icon value = prop.GetObjectValue() as Icon;
        if(value != null)
        {
            int save = SaveDC(canvas.hdc);
            IntersectClipRect(canvas.hdc, x, y, x + width, y + height);
            DrawIcon(canvas.hdc, x, y+1, value.hIcon);
            RestoreDC(canvas.hdc, save);
        }
    }
}

class FilenamePropertyEditor : PropertyEditor
{
    string GetStringValue(PropertyGridValue prop)
    {
        object value = prop.GetObjectValue();
        return value as string;
    }

    bool SetStringValue(PropertyGridValue prop, string value)
    {
        prop.SetObjectValue(value);
        return true;
    }

    static Textbox textBox = null;
    static Button button = null;
    PropertyGridValue selectedProperty = null;
    PropertyGrid grid = null;

    void OnButtonClicked(object sender, void* args)
    {
        OpenFileDialog dlg = new OpenFileDialog();
        dlg.Filter = "All Files|*.*|";
        dlg.Title = "Select File";
        if(selectedProperty.Symbol.HasAttribute("FilenameFilter"))
            dlg.Filter = selectedProperty.Symbol.GetAttributeString("FilenameFilter");
        string fileName = selectedProperty.GetObjectValue() as string;
        if(fileName)
            dlg.FileName = fileName;
        if(dlg.Show(button.parent.parent))
        {
            selectedProperty.SetObjectValue(dlg.FileName);
        }
        button.Visible = true;
        textBox.Visible = true;
        textBox.Focus();
    }

    void OnEnterEdit(PropertyGrid pgrid, PropertyGridValue prop, int y)
    {
        selectedProperty = prop;
        grid = pgrid;

        if(button == null)
        {
            textBox = new Textbox(pgrid, 0, 0, 0, 19);
            button = new Button(pgrid, 0, 0, 19, 19);
            button.Text = "...";
        }
        
        button.Parent = grid;
        button.Clicked.clear();
        button.Clicked += new Delegate(this, FilenamePropertyEditor.OnButtonClicked);

        textBox.Parent = grid;
        textBox.Text = "";
        textBox.Leave.clear();
        textBox.Leave += new Delegate(this, FilenamePropertyEditor.OnTextBoxLeave);

        textBox.SetPosition(pgrid.width - 100, y);
        button.SetPosition(pgrid.width - 19-16, y);
        button.Visible = true;
        textBox.Visible = true;
        textBox.Focus();
    }

    void OnTextBoxLeave(object sender, void *args)
    {
        OnLeaveEdit(grid, selectedProperty);
    }

    void OnLeaveEdit(PropertyGrid pgrid, PropertyGridValue prop)
    {
        if(button != null)
        {
            textBox.Visible = false;
            button.Visible = false;
        }
    }

    void Draw(Canvas canvas, int x, int y, int width, int height, Font font, uint foreColor, object obj, RTTIProperty prop)
    {
        string value = GetStringValue(prop);
        if(value != null)
            canvas.RenderPathText(x, y + 3, width, height, value, font, foreColor);
    }
}

resource CollectionEditorJson "CollectionEditor.json";

class CollectionEditor : Dialog
{
    Dropdown ddItemType;
    Listbox lbItems;
    PropertyGrid pgItem;
    Button btnAdd;
    Button btnRemove;
    Button btnMoveUp;
    Button btnMoveDown;

    RTTIProperty property;
    iarray collection;

    void OnCreate()
    {
        LoadLayout(new string(CollectionEditorJson));

        ddItemType = GetChildByName("ddItemType") as Dropdown;
        lbItems = GetChildByName("lbItems") as Listbox;
        pgItem = GetChildByName("pgItem") as PropertyGrid;
        btnAdd = GetChildByName("btnAdd") as Button;
        btnRemove = GetChildByName("btnRemove") as Button;
        btnMoveUp = GetChildByName("btnMoveUp") as Button;
        btnMoveDown = GetChildByName("btnMoveDown") as Button;

        lbItems.SelectedIndexChanged += new Delegate(this, CollectionEditor.LbItems_Click);

        btnAdd.Clicked += new Delegate(this, CollectionEditor.BtnAdd_Clicked);
        btnRemove.Clicked += new Delegate(this, CollectionEditor.BtnRemove_Clicked);
        btnMoveUp.Clicked += new Delegate(this, CollectionEditor.BtnMoveUp_Clicked);
        btnMoveDown.Clicked += new Delegate(this, CollectionEditor.BtnMoveDown_Clicked);
        
        pgItem.PropertySelected += new Delegate(this, CollectionEditor.pgItem_PropertySelected);
        pgItem.PropertyChanged += new Delegate(this, CollectionEditor.pgItem_PropertySelected);

        if(property.HasAttribute("AcceptTypes"))
        {
            string types = property.GetAttributeString("AcceptTypes");
            array<string> typeNames = types.split(",");
            typeNames.sort();
            for(int i = 0; i < typeNames.count; ++i)
            {
                ddItemType.Items.Add(typeNames[i]);
            }
            ddItemType.SelectedIndex = 0;
        }

        lbItems.Style = ListboxStyle.OwnerDraw;
        lbItems.DrawItem += new Delegate(this, CollectionEditor.LbItems_DrawItem);

        LoadCollection();

        btnRemove.Enabled = false;
        btnMoveUp.Enabled = false;
        btnMoveDown.Enabled = false;
    }

    void LoadCollection()
    {
        for(int i = 0; i < collection.getElementCount(); ++i)
        {
            object obj = null;
            collection.getElement(i, &obj);
            lbItems.Items.Add(obj);
        }
    }

    void LbItems_Click(object sender, void* args)
    {
        pgItem.SelectedObject = lbItems.SelectedItem;
        
        btnRemove.Enabled = lbItems.SelectedIndex != -1;
        btnMoveUp.Enabled = lbItems.SelectedIndex > 0;
        btnMoveDown.Enabled = lbItems.SelectedIndex < lbItems.Items.Count - 1;
    }

    void BtnAdd_Clicked(object sender, void* args)
    {
        RTTIClassType cls = RTTIType.GetType(ddItemType.Text) as RTTIClassType;
        if(cls == null)
            return;
        object (*ctor)() = cls.GetCreator().address;
        object newInstance = ctor();

        collection.addElement(&newInstance);
        lbItems.Items.Add(newInstance);
        pgItem.SelectedObject = newInstance;
        lbItems.SelectedIndex = lbItems.Items.Count - 1;

        btnRemove.Enabled = true;
        btnMoveUp.Enabled = lbItems.SelectedIndex > 0;
        btnMoveDown.Enabled = lbItems.SelectedIndex < lbItems.Items.Count - 1;
    }

    void BtnRemove_Clicked(object sender, void *args)
    {
        if(MessageBox.Show("Are you sure you want to remove this item?", "Remove", MsgFlags.Question | MsgFlags.YesNo) != 1)
            return;

        collection.removeElementAt(lbItems.SelectedIndex); 

        lbItems.Items.RemoveAt(lbItems.SelectedIndex);

        btnRemove.Enabled = lbItems.SelectedIndex != -1;
        btnMoveUp.Enabled = lbItems.SelectedIndex > 0;
        btnMoveDown.Enabled = lbItems.SelectedIndex < lbItems.Items.Count - 1;

        pgItem.SelectedObject = lbItems.SelectedItem;
    }

    void BtnMoveUp_Clicked(object sender, void *args)
    {
        object a = null;
        object b = null;
        int index = lbItems.SelectedIndex;

        collection.getElement(index, &a);
        collection.getElement(index-1, &b);
        collection.setElement(index, &b);
        collection.setElement(index-1, &a);

        lbItems.Items[index] = b;
        lbItems.Items[index-1] = a;

        lbItems.SelectedIndex = index-1;

        btnMoveUp.Enabled = lbItems.SelectedIndex > 0;
        btnMoveDown.Enabled = lbItems.SelectedIndex < lbItems.Items.Count - 1;
    }

    void BtnMoveDown_Clicked(object sender, void *args)
    {
        object a = null;
        object b = null;
        int index = lbItems.SelectedIndex;

        collection.getElement(index, &a);
        collection.getElement(index+1, &b);
        collection.setElement(index, &b);
        collection.setElement(index+1, &a);

        lbItems.Items[index] = b;
        lbItems.Items[index+1] = a;

        lbItems.SelectedIndex = index+1;

        btnMoveUp.Enabled = lbItems.SelectedIndex > 0;
        btnMoveDown.Enabled = lbItems.SelectedIndex < lbItems.Items.Count - 1;
    }

    void LbItems_DrawItem(object sender, void *param)
    {
        DrawItemInfo info = (DrawItemInfo)param;

        if(info.index < 0 || info.index >= lbItems.Items.Count)
            return;

        if(info.selected)
        {
            info.canvas.FillRectangle(info.left, info.top, info.width, info.height, new Brush(0xaa5555));
        }

        RTTIClassType cls = lbItems.Items[info.index].getClassType();
        string text = cls.name;
        RTTIProperty pName = cls.GetProperty("Name");
        if(pName != null)
        {
            string name = pName.GetObjectValue(lbItems.Items[info.index]) as string;
            if(name != null && name.length > 0)
            {
                text += " ";
                text += name;
            }
        }
        info.canvas.DrawText(info.left + 2, info.top + 1, text, this.Font, lbItems.Enabled ? lbItems.ForeColor : WindowDefaults.WindowForeColorDisabled);
    }

    void pgItem_PropertySelected(object sender, void *param)
    {
        lbItems.Invalidate();
    }
}

class CollectionPropertyEditor : PropertyEditor
{
    /*string GetStringValue(PropertyGridValue prop)
    {
        object value = prop.GetObjectValue();
        return value as string;
    }

    bool SetStringValue(PropertyGridValue prop, string value)
