        if(button != null)
        {
            textBox.Visible = false;
            button.Visible = false;
        }
    }

    void Draw(Canvas canvas, int x, int y, int width, int height, Font font, uint foreColor, object obj, RTTIProperty prop)
    {
        /*string value = GetStringValue(prop);
        if(value != null)
            canvas.RenderPathText(x, y + 3, width, height, value, font, foreColor);*/
    }
}

class PropertyGridValue
{
    string name;
    string label;
    object target;
    RTTIProperty prop;
    void* pData;
    RTTIField field;
    int row;
    int level;
    int expands;
    PropertyEditor editor;
    void* pCached;

    RTTIType get DataType()
    {
        if(prop != null)
            return prop.propertyType;
        else if(field != null)
            return field.fieldType;
        else
            return null;
    }

    RTTISymbol get Symbol() 
    {
        if(prop != null)
            return prop;
        else if(field != null)
            return field;
        else
            return null;
    }

    PropertyGridValue constructor(string nm, string lbl, object obj, RTTIProperty p, void *data, RTTIField f)
    {
        name = nm;
        label = lbl;
        target = obj;
        prop = p;
        pData = data;
        field = f;
        if(target != null && prop != null && prop.propertyType.IsStruct())
        {
            int sz = ((RTTIStructType)prop.propertyType).size;
            pCached = memory.alloc(sz);
            prop.GetStructValue(target, sz, pCached); 
        }
        if(pData != null && field != null && field.fieldType.IsStruct())
        {
            int sz = ((RTTIStructType)field.fieldType).size;
            pCached = memory.alloc(sz);
            field.GetStructValue(pData, sz, pCached);
        }
        return this;
    }

    void destructor()
    {
        if(prop != null && prop.propertyType.IsStruct())
        {
            memory.free(pCached);
        }
        else if(field != null && field.fieldType.IsStruct())
        {
            memory.free(pCached);
        }
    }

    bool GetBoolValue()
    {
        if(target != null && prop != null)
        {
            return prop.GetBoolValue(target);
        }
        else if(pData != null && field != null)
        {
            return field.GetBoolValue(pData);
        }
        else
        {
            return 0;
        }
    }

    void SetBoolValue(bool value)
    {
        if(target != null && prop != null)
        {
            prop.SetBoolValue(target, value);
        }
        else if(pData != null && field != null)
        {
            field.SetBoolValue(pData, value);
        }
    }

    byte GetByteValue()
    {
        if(target != null && prop != null)
        {
            return prop.GetByteValue(target);
        }
        else if(pData != null && field != null)
        {
            return field.GetByteValue(pData);
        }
        else
        {
            return 0;
        }
    }

    void SetByteValue(byte value)
    {
        if(target != null && prop != null)
        {
            prop.SetByteValue(target, value);
        }
        else if(pData != null && field != null)
        {
            field.SetByteValue(pData, value);
        }
    }

    short GetShortValue()
    {
        if(target != null && prop != null)
        {
            return prop.GetShortValue(target);
        }
        else if(pData != null && field != null)
        {
            return field.GetShortValue(pData);
        }
        else
        {
            return 0;
        }
    }

    void SetShortValue(short value)
    {
        if(target != null && prop != null)
        {
            prop.SetShortValue(target, value);
        }
        else if(pData != null && field != null)
        {
            field.SetShortValue(pData, value);
        }
    }

    int GetIntValue()
    {
        if(target != null && prop != null)
        {
            return prop.GetIntValue(target);
        }
        else if(pData != null && field != null)
        {
            return field.GetIntValue(pData);
        }
        else
        {
            return 0;
        }
    }

    void SetIntValue(int value)
    {
        if(target != null && prop != null)
        {
            prop.SetIntValue(target, value);
        }
        else if(pData != null && field != null)
        {
            field.SetIntValue(pData, value);
        }
    }

    long GetLongValue()
    {
        if(target != null && prop != null)
        {
            return prop.GetLongValue(target);
        }
        else if(pData != null && field != null)
        {
            return field.GetLongValue(pData);
        }
        else
        {
            return 0;
        }
    }

    void SetLongValue(long value)
    {
        if(target != null && prop != null)
        {
            prop.SetLongValue(target, value);
        }
        else if(pData != null && field != null)
        {
            field.SetLongValue(pData, value);
        }
    }

    float GetFloatValue()
    {
        if(target != null && prop != null)
        {
            return prop.GetFloatValue(target);
        }
        else if(pData != null && field != null)
        {
            return field.GetFloatValue(pData);
        }
        else
        {
            return 0;
        }
    }

    void SetFloatValue(float value)
    {
        if(target != null && prop != null)
        {
            prop.SetFloatValue(target, value);
        }
        else if(pData != null && field != null)
        {
            field.SetFloatValue(pData, value);
        }
    }

    double GetDoubleValue()
    {
        if(target != null && prop != null)
        {
            return prop.GetDoubleValue(target);
        }
        else if(pData != null && field != null)
        {
            return field.GetDoubleValue(pData);
        }
        else
        {
            return 0;
        }
    }

    void SetDoubleValue(double value)
    {
        if(target != null && prop != null)
        {
            prop.SetDoubleValue(target, value);
        }
        else if(pData != null && field != null)
        {
            field.SetDoubleValue(pData, value);
        }
    }

    object GetObjectValue()
    {
        if(target != null && prop != null)
        {
            return prop.GetObjectValue(target);
        }
    }

    void SetObjectValue(object value)
    {
        if(target != null && prop != null)
        {
            prop.SetObjectValue(target, value);
        }
    }

    void SetStructValue(int sz, void *value)
    {
        if(target != null && prop != null)
        {
            prop.SetStructValue(target, sz, value);
        }
        else if(pData != null && field != null)
        {
            field.SetStructValue(pData, sz, value);
        }
    }

    void GetStructValue(int sz, void *value)
    {
        if(target != null && prop != null)
        {
            prop.GetStructValue(target, sz, value);
        }
        else if(pData != null && field != null)
        {
            field.GetStructValue(pData, sz, value);
        }
    }
}

bool operator<(PropertyGridValue a, PropertyGridValue b)
{
    return a.label < b.label;
}

[SerializeSkip("Children,SelectedObject")]
[DefaultWidth(150)]
[DefaultHeight(150)]
class PropertyGrid : Control
{
    bool border = true;
    Pen forePen;
    object selectedObject;
    array<PropertyGridValue> properties = new array<PropertyGridValue>();
    int topIndex = 0;
    Pen gridPen;
    VScrollbar vscroll;
    PropertyGridValue selectedProperty;
    PropertyEditor editor;
    Event PropertySelected = new Event();
    Event PropertyChanged = new Event();

    bool get Border() => border;
    void set Border(bool value)
    {
        border = value;
        Invalidate();
    }

    [Browsable(false)]
    object get SelectedObject() => selectedObject;
    void set SelectedObject(object value)
    {
        FinishEdit();
        selectedObject = value;
        GetObjectProperties(properties, selectedObject);
        topIndex = 0;
        vscroll.Position = 0;
        Layout();
        AdjustVScroll();
        Invalidate();
    }

    uint GetWindowStyle()
    {
        return WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_CLIPCHILDREN;
    }

    PropertyGrid constructor(Window parent, int x, int y, int w, int h)
    {
        base(parent, x, y, w, h);
        doubleBuffered = true;
        GetHandle();
        forePen = new Pen(PS_SOLID, 1, ForeColor);
        gridPen = new Pen(PS_SOLID, 1, 0x444444);
        return this;
    }

    void OnCreate()
    {
        vscroll = new VScrollbar(this, width - 16 - 1, 1, 16, height-2);
        vscroll.Scrolled += new Delegate(this, PropertyGrid.VScroll_Scrolled);
    }

    void VScroll_Scrolled(object sender, void* args)
    {
        FinishEdit();
        topIndex = vscroll.Position;
        Layout();
        Invalidate();
    }

    void AdjustVScroll()
    {
        vscroll.MaxValue = (properties.count - (height / 20)) >? 0;        
        int itemHeight = 20;
        int numVisible = height / itemHeight;
        vscroll.PageSize = numVisible;
        vscroll.Invalidate();
    }

    PropertyEditor GetEditor(RTTISymbol prop, RTTIType type)
    {
        if(prop.HasAttribute("PropertyEditor"))
        {
            string editorClass = prop.GetAttributeString("PropertyEditor");
            RTTIClassType editorType = RTTIType.GetType(editorClass) as RTTIClassType;
            if(editorType != null)
            {
                PropertyEditor* (*creator)() = editorType.GetCreator().address;
                if(creator != null)
                {
                    PropertyEditor editor = creator();
                    return editor;
                }
            }
        }

        if(type.IsEnum())
            return new EnumPropertyEditor();
        else if(type == RTTIType.Bool)
            return new BoolPropertyEditor();
        else if(type == RTTIType.Byte)
            return new BytePropertyEditor();
        else if(type == RTTIType.UByte)
            return new UBytePropertyEditor();
        else if(type == RTTIType.Short)
            return new ShortPropertyEditor();
        else if(type == RTTIType.UShort)
            return new UShortPropertyEditor();
        else if(type == RTTIType.Int)
            return new IntPropertyEditor();
        else if(type == RTTIType.UInt)
            return new UIntPropertyEditor();
        else if(type == RTTIType.Long)
            return new LongPropertyEditor();
        else if(type == RTTIType.ULong)
            return new ULongPropertyEditor();
        else if(type == RTTIType.Float)
            return new FloatPropertyEditor();
        else if(type == RTTIType.Double)
            return new DoublePropertyEditor();
        else if(type.name == "string*")
            return new StringPropertyEditor();
        else if(type.name == "Bitmap*")
            return new BitmapPropertyEditor();
        else if(type.name == "Icon*")
            return new IconPropertyEditor();
        else if((type.IsClassRef()
                && ((RTTIClassType)((RTTIPointerType)type).elementType).IsClassOf(typeof(iarray))))
        {
            return new CollectionPropertyEditor();
        }
        else
        {
            string editorTypeName = PropertyEditor.editors[type.name];
            if(editorTypeName != null)
            {
                RTTIClassType editorType = RTTIType.GetType(editorTypeName) as RTTIClassType;
                if(editorType != null)
                {
                    PropertyEditor* (*creator)() = editorType.GetCreator().address;
                    if(creator != null)
                    {
                        PropertyEditor editor = creator();
                        return editor;
                    }
                }
            }
            return null;
        }
    }

    void GetClassProperties(array<PropertyGridValue> properties, RTTIClassType cls, object target)
    {
        if(cls.baseClass != null)
            GetClassProperties(properties, cls.baseClass, target);
        array<string> props = cls.EnumProperties();
        for(int i = 0; i < props.count; i++)
        {
            RTTIProperty prop = cls.GetProperty(props[i]);

            if(prop.HasAttribute("Browsable") && !prop.GetAttributeBool("Browsable"))
                continue;

            //if(prop.getter == null || prop.setter == null)
            //    continue;
            RTTIType ptype = prop.propertyType;

            if(prop.getter == null || 
                (prop.setter == null && !(ptype.IsClassRef()
                && ((RTTIClassType)((RTTIPointerType)ptype).elementType).IsClassOf(typeof(iarray)))))
            {
                continue;
            }

            if((prop.getter.flags & (SymbolFlags.Private| SymbolFlags.Protected)) != 0)
                continue;

            if(prop.setter != null && (prop.setter.flags & (SymbolFlags.Private| SymbolFlags.Protected)) != 0)
                continue;

            if((prop.flags & SymbolFlags.Static) != 0)
                continue;

            bool found = false;
            for(int i = 0; i < properties.count; i++)
            {
                if(properties[i].name == prop.name)
                {
                    found = true;
                    break;
                }
            }

            if(found)
                continue;
            
            string label = prop.name;
            if(prop.HasAttribute("DisplayName"))
                label = prop.GetAttributeString("DisplayName");

            PropertyGridValue pv = new PropertyGridValue(prop.name, label, target, prop, null, null);
            pv.editor = GetEditor(prop, prop.propertyType);
            properties.add(pv);
            if((prop.propertyType.IsClassRef() || prop.propertyType.IsStruct()) && pv.editor == null)
                pv.expands = 1;
        }
    }

    void GetObjectProperties(array<PropertyGridValue> properties, object selectedObject)
    {
        properties.clear();
        if(selectedObject != null)
        {
            RTTIClassType type = selectedObject.getClassType();
            GetClassProperties(properties, type, selectedObject);
            properties.sort();
        }
    }

    void GetStructProperties(array<PropertyGridValue> properties, RTTIStructType structType, void *pData)
    {
        properties.clear();
        array<string> fields = structType.EnumFields();
        for(int i = 0; i < fields.count; i++)
        {
            RTTIField field = structType.GetField(fields[i]);
            if(field.HasAttribute("Browsable") && !field.GetAttributeBool("Browsable"))
                continue;
            string label = field.name;
            if(field.HasAttribute("DisplayName"))
                label = field.GetAttributeString("DisplayName");
            PropertyGridValue pv = new PropertyGridValue(field.name, label, null, null, pData, field);
            pv.editor = GetEditor(field, field.fieldType);
            properties.add(pv);
            if((field.fieldType.IsClassRef() || field.fieldType.IsStruct()) && pv.editor == null)
                pv.expands = 1;
        }
        properties.sort();
    }

    void Layout()
    {
        for(int i = 0; i < properties.count; i++)
        {
            properties[i].row = i - topIndex;
        }
    }

    void OnPaint(Canvas canvas)
    {
        for(int i = topIndex; i < properties.count; i++)
        {
            PropertyGridValue prop = properties[i];
            
            if(prop.row * 20 > height)
                break;   
                
            Bitmap icon = null;
            if(prop.expands == 1)
                icon = WindowDefaults.PropertyExpand;
            else if(prop.expands == 2)
                icon = WindowDefaults.PropertyCollapse;
            int x = 5 + prop.level * 8;
            if(icon != null)
                x += 10;

            canvas.RenderText(x, 3 + prop.row * 20, width-100-x, 20, prop.name, this.Font, ForeColor);
            if(prop.editor != null)
                prop.editor.Draw(canvas, width-100, prop.row * 20, 99-16, 19, this.Font, ForeColor, prop);
            canvas.DrawLine(1, 2 + (prop.row + 1) * 20, vscroll.x, 2 + (prop.row + 1) * 20, gridPen);
            if(icon != null)
                canvas.DrawBitmap(x - 10, 8 + prop.row * 20, 7, 7, icon);
        }

        if(border)
        {
            canvas.DrawRectangle(0, 0, width, height, forePen);
        }
    }

    PropertyGridValue GetPropertyAt(int y)
    {
        int index = (y / 20) + topIndex;
        if(index >= 0 && index < properties.count)
        {
            PropertyGridValue prop = properties[index];
            return prop;
        }
        return null;
    }

    void OnMouseDown(int button, int x, int y)
    {
        if(button == 1)
        {
            Focus();

            PropertyGridValue prop = GetPropertyAt(y);
            if(prop != null)
            {
                if(prop.expands == 1)
                {
                    prop.expands = 2;
                    array<PropertyGridValue> subProperties = new array<PropertyGridValue>();
                    if(prop.DataType.IsClassRef())
                    {
                        object target = prop.prop.GetObjectValue(prop.target);
                        GetObjectProperties(subProperties, target);
                    }
                    else if(prop.DataType.IsStruct())
                    {                        
                        RTTIStructType structType = prop.DataType as RTTIStructType;
                        GetStructProperties(subProperties, structType, prop.pCached);
                    }
                    int index = properties.indexOf(prop) + 1;
                    for(int i  = 0; i < subProperties.count; ++i)
                    {
                        subProperties[i].level = prop.level + 1;
                        properties.insert(index + i, subProperties[i]);
                    }
                    Layout();
                    AdjustVScroll();
                    Invalidate();
                }
                else if(prop.expands == 2)
                {
                    prop.expands = 1;
                    int index = properties.indexOf(prop) + 1;
                    while(index < properties.count && properties[index].level > prop.level)
                    {
                        properties.removeAt(index);
                    }
                    Layout();
                    AdjustVScroll();
                    Invalidate();
                }
                else
                {
                    if(prop.editor != null && editor != prop.editor)
                    {
                        PropertySelected.invoke(this, null);
                        prop.editor.OnEnterEdit(this, prop, prop.row * 20+3);
                        editor = prop.editor;
                        selectedProperty = prop;
                    }
                }
            }
        }
    }

    void FinishEdit()
    {
        if(editor != null)
        {
            editor.OnLeaveEdit(this, selectedProperty);
            editor = null;
            selectedProperty = null;
        }
    }

    void Commit(PropertyGridValue prop)
    {
        PropertyChanged.invoke(this, null);

        int index = properties.indexOf(prop);
        if(index == -1)
            return;
        int level = prop.level;
        if(level == 0)
            return;
        if(prop.pData == null)
            return;

        while(properties[index].level >= level)
            index--;

        if(index >= 0 && index < properties.count)
        {
            PropertyGridValue parent = properties[index];
            if(parent.DataType.IsStruct())
            {
                int sz = ((RTTIStructType)parent.DataType).size;
                parent.SetStructValue(sz, parent.pCached);
                Commit(parent);
            }
        }
    }

    void OnMouseWheel(int delta, int x, int y)
    {
        if(delta > 0)
        {
            if(vscroll.Position > 0)
            {
                FinishEdit();
                vscroll.Position -= 1;
                topIndex = vscroll.Position;
                Layout();
                Invalidate();
            }
        }
        else if(delta < 0)
        {
            if(vscroll.Position < vscroll.MaxValue)
            {
                FinishEdit();
                vscroll.Position += 1;
                topIndex = vscroll.Position;
                Layout();
                Invalidate();
            }
        }
    }

    void OnSizeChanged()
    {
        vscroll.Left = Width - 16 - 1;
        vscroll.Height = Height - 2;
        Layout();
        AdjustVScroll();
    }
}
