using jargon;

[DefaultWidth(100)]
[DefaultHeight(30)]
class Button : Control
{
    int modalResult = -1;
    bool inside = false;

    Event Clicked = new Event();

    int get ModalResult() => modalResult;
    void set ModalResult(int value) => modalResult = value;

    Button constructor(Window parent, int x, int y, int width, int height)
    {
        base(parent, x, y, width, height);
        GetHandle();
        BackColor = WindowDefaults.ButtonBackColor;
        return this;
    }

    uint GetWindowStyle()
    {
        return WS_CHILD | WS_VISIBLE | WS_TABSTOP;
    }

    void OnMouseEnter()
    {
        inside = true;
        Invalidate();
    }

    void OnMouseLeave()
    {
        inside = false;
        Invalidate();
    }

    protected uint GetBackColor()
    {
        if(!Enabled)
            return WindowDefaults.ButtonBackColorDisabled;
        else if(inside)
            return WindowDefaults.ButtonBackColorActive;
        else
            return BackColor;
    }

    void OnPaintBackground(Canvas canvas)
    {
        RECT r = ClientRect;
        Brush backBrush = new Brush(GetBackColor());
        canvas.FillRectangle(0, 0, r.right, r.bottom, backBrush);
    }

    void OnPaint(Canvas canvas)
    {
        SIZE ts = canvas.MeasureText(Text, this.Font);
        int x = (width - ts.cx) / 2;
        int y = (height - ts.cy) / 2;
        canvas.DrawText(x, y, Text, this.Font, ForeColor);
        if(HasFocus())
        {
            //RECT fr = {x-2, y-2, x+ts.cx+2, y+ts.cy+2};
            RECT fr = {0, 0, width, height};
            DrawFocusRect(canvas.hdc, &fr);
        }
    }

    void OnMouseDown(int button, int x, int y)
    {
        if(button == 1)
        {
            Focus();
            SetCapture(hWnd);
        }
    }

    void DoClick()
    {
        Clicked.invoke(this, null);

        if(modalResult != -1)
        {
            BaseWindow w = parent;
            while(w)
            {
                if(w is Dialog)
                {
                    Dialog d = w as Dialog;
                    d.ModalResult = modalResult;
                    d.Close();
                    break;
                }
                w = w.parent;
            }
        }
    }

    void OnMouseUp(int button, int x, int y)
    {
        if(button == 1)
        {
            ReleaseCapture();
            RECT r = ClientRect;
            if(x>= 0 && x < r.right && y >= 0 && y < r.bottom)
            {
                DoClick();
            }
        }
    }

    int OnKeyDown(int key, int flags)
    {
        if(key == VK_SPACE)
        {
            DoClick();
            return 0;
        }
        return 1;
    }
}
