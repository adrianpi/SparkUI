class MenuItem
{
    static int _id = 10000;
    string text;
    uint Id;
    PopupMenu subMenu;
    uint shortcut;
    string name;
    weak MenuBase parentMenu;
    bool enabled = true;
    bool checked = false;
    int radioGroup = 0;

    Event Clicked = new Event();

    string get Name() => name;
    void set Name(string value) => name = value;

    string get Text() => text;
    void set Text(string value) 
    {
        text = value;
        if(parentMenu != null)
        {
            string t = DisplayText;
            ModifyMenuA(parentMenu.hMenu, Id, MF_BYCOMMAND | MF_STRING, Id, t.c_str());
        }
    }

    [Browsable(false)]
    PopupMenu get SubMenu() => subMenu;
    void set SubMenu(PopupMenu value) => subMenu = value;

    [PropertyEditor("ShortcutPropertyEditor")]
    uint get Shortcut() => shortcut;
    void set Shortcut(uint value)
    {
        shortcut = value;
        if(parentMenu != null)
        {
            string t = DisplayText;
            ModifyMenuA(parentMenu.hMenu, Id, MF_BYCOMMAND | MF_STRING, Id, t.c_str());
        }
    }

    bool get Enabled() => enabled;
    void set Enabled(bool value)
    {
        enabled = value;
        if(parentMenu != null)
        {
            EnableMenuItem(parentMenu.hMenu, Id, MF_BYCOMMAND | (enabled ? MF_ENABLED : MF_GRAYED));
        }
    }

    bool get Checked() => checked;
    void set Checked(bool value)
    {
        checked = value;
        if(parentMenu != null)
        {
            if(checked && radioGroup != 0)
            {
                for(int i = 0; i < parentMenu.items.count; ++i)
                {
                    MenuItem other = parentMenu.items[i];
                    if(other == this)
                        continue;
                    if(other.radioGroup == radioGroup)
                    {
                        other.checked = false;
                        CheckMenuItem(parentMenu.hMenu, other.Id, MF_BYCOMMAND | MF_UNCHECKED);
                    }
                }
            }

            CheckMenuItem(parentMenu.hMenu, Id, MF_BYCOMMAND | (checked ? MF_CHECKED : MF_UNCHECKED));
        }
    }

    int get RadioGroup() => radioGroup;
    void set RadioGroup(int value)
    {
        radioGroup = value;
        if(parentMenu != null)
        {
            MENUITEMINFO mii = {};
            mii.cbSize = sizeof(mii);
            mii.fMask = MIIM_FTYPE;
            mii.fType = radioGroup != 0 ? MFT_RADIOCHECK : 0;

            SetMenuItemInfoA(parentMenu.hMenu, Id, false, &mii);
        }
    }

    string get DisplayText()
    {
        string result = text;
        if(shortcut != 0)
        {
            result += "\t";
            result += GetShortcutText(shortcut);
        }
        return result;
    }

    MenuItem constructor()
    {
        base();
        Id = _id++;
        name = string.format("MenuItem%d", Id);
        return this;
    }

    static string GetShortcutText(uint shortcut)
    {
        uint sc = shortcut;
        string result = "";
        if(sc & SCK_CONTROL)
        {
            result += "Ctrl+";
            sc &= ~SCK_CONTROL;
        }
        if(sc & SCK_SHIFT)
        {
            result += "Shift+";
            sc &= ~SCK_SHIFT;
        }
        
        if(sc == 0)
        {
            return "None";
        }

        /*byte buff[80];
        uint scan = MapVirtualKeyA(sc, MAPVK_VK_TO_VSC);
        GetKeyNameTextA(scan << 16, buff, 80);
        result += new string(buff);*/

        if(sc >= '0' && sc <= '9')
            result += (byte)sc;
        else if(sc >= 'A' && sc <= 'Z')
            result += (byte)sc;
        else if(sc >= VK_F1 && sc <= VK_F12)
            result += string.format("F%d", sc - VK_F1 + 1);
        else if(sc == VK_RETURN)
            result += "Enter";
        else if(sc == VK_ESCAPE)
            result += "Esc";
        else if(sc == VK_SPACE)
            result += "Space";
        else if(sc == VK_PAGE_UP)
            result += "PgUp";
        else if(sc == VK_PAGE_DOWN)
            result += "PgDown";
        else if(sc == VK_END)
            result += "End";
        else if(sc == VK_HOME)
            result += "Home";
        else if(sc == VK_LEFT)
            result += "Left";
        else if(sc == VK_UP)
            result += "Up";
        else if(sc == VK_RIGHT)
            result += "Right";
        else if(sc == VK_DOWN)
            result += "Down";
        else if(sc == VK_DELETE)
            result += "Del";
        else
            result += string.format("0x%X", sc);

        return result;
    }
}

class MenuBase
{
    long hMenu = 0;
    MenuBase Parent;
    array<MenuItem> items = new array<MenuItem>();

    array<MenuItem> get Items() => items;

    virtual long CreateHandle() => 0;

    void Invalidate()
    {
        DestroyMenu(hMenu);
        hMenu = 0;

        for(int i = 0; i < items.count; ++i)
        {
            MenuItem item = items[i];
            if(item.SubMenu != null)
                item.SubMenu.Invalidate();
        }
    }

    long GetHandle()
    {
        if(hMenu == 0)
        {
            hMenu = CreateHandle();
            for(int i = 0; i < items.count; ++i)
            {
                MenuItem item = items[i];
                item.parentMenu = this;
                if(item.text == "-")
                {
                    AppendMenuA(hMenu, MF_SEPARATOR, 0, null);
                }
                else
                {
                    string text = item.DisplayText;
                    
                    AppendMenuA(hMenu, 
                        MF_STRING | (item.subMenu != null ? MF_POPUP : 0), 
                        item.subMenu != null ? item.subMenu.GetHandle() : item.Id,
                        text.c_str());

                    if(!item.Enabled)
                        EnableMenuItem(hMenu, item.Id, MF_BYCOMMAND | MF_GRAYED);

                    if(item.Checked)
                        CheckMenuItem(hMenu, item.Id, MF_BYCOMMAND | MF_CHECKED);

                    if(item.RadioGroup != 0)
                    {
                        MENUITEMINFO mii = {};
                        mii.cbSize = sizeof(mii);
                        mii.fMask = MIIM_FTYPE;
                        mii.fType = MFT_RADIOCHECK;

                        SetMenuItemInfoA(hMenu, item.Id, false, &mii);
                    }
                }
            }
        }

        return hMenu;
    }

    bool HandleCommand(uint commandId)
    {
        for(int i = 0; i < items.count; i++)
        {
            if(items[i].subMenu != null)
            {
                if(items[i].subMenu.HandleCommand(commandId))
                    return true;
            }
            if(items[i].Id == commandId)
            {
                items[i].Clicked.invoke(items[i], null);
                return true;
            }
        }

        return false;
    }

    bool HandleShortcut(int key)
    {
        for(int i = 0; i < items.count; i++)
        {
            if(!items[i].Enabled)
                continue;

            if(items[i].subMenu != null)
            {
                if(items[i].subMenu.HandleShortcut(key))
                    return true;
            }
            if(items[i].Shortcut == key)
            {
                items[i].Clicked.invoke(items[i], null);
                return true;
            }
        }

        return false;
    }

    MenuItem GetItem(string name)
    {
        for(int i = 0; i < items.count; i++)
        {
            if(items[i].Name == name)
                return items[i];
            if(items[i].SubMenu != null)
            {
                MenuItem found = items[i].SubMenu.GetItem(name);
                if(found != null)
                    return found;
            }
        }
        return null;
    }
}

int GetLastError() external;

class PopupMenu : MenuBase
{
    long CreateHandle()
    {
        return CreatePopupMenu();
    }

    void Show(Window window, int x, int y)
    {
        POINT pt = {x, y};
        ClientToScreen(window.hWnd, &pt);

        long hPopup = GetHandle();

        int cmd = TrackPopupMenu(
            hPopup,
            TPM_RIGHTBUTTON | TPM_RETURNCMD,
            pt.x, pt.y,
            0,
            window.hWnd,
            null);

        HandleCommand(cmd);
    }
}

class Menu : MenuBase
{
    long CreateHandle()
    {
        return CreateMenu();
    }
}

[SerializeSkip("Parent")]
class BaseWindow
{
    long hWnd = 0;
    weak BaseWindow parent = null;
    array<BaseWindow> children = new array<BaseWindow>();
    string className;
    string text;
    RECT clientRect;
    uint backColor = WindowDefaults.WindowBackColor;
    uint foreColor = WindowDefaults.WindowForeColor;
    Brush backBrush;
    int x = CW_USEDEFAULT;
    int y = CW_USEDEFAULT;
    int width = CW_USEDEFAULT;
    int height = CW_USEDEFAULT;
    Font Font = WindowDefaults.NormalTextFont;
    bool visible = false;
    bool enabled = true;
    static BaseWindow hoverWindow = null;
    bool doubleBuffered = false;
    Event Resize = new Event();
    string name;

    BaseWindow constructor()
    {
        base();
        text = getClassName();
        name = getClassName();
        backBrush = new Brush(backColor);
        return this;
    }

    void destructor()
    {
        Log("Destroying %s window %p", getClassName(), this);
        if(memDC)
        {
            SelectObject(memDC, oldBmp);
            DeleteDC(memDC);
        }
        base();
    }

    virtual uint GetClassStyle()
    {
        return CS_HREDRAW | CS_VREDRAW;
    }

    virtual uint GetWindowStyle()
    {
        return WS_OVERLAPPEDWINDOW;
    }

    virtual int GetWindowStyleEx()
    {
        return 0;
    }

    virtual string GetWindowClassName()
    {
        return getClassName();
    }

    virtual void RegisterClass()
    {
        className = GetWindowClassName();

        WNDCLASSA wc = {};
        wc.style         = GetClassStyle();
        wc.lpfnWndProc   = Window._WindowProc;
        wc.hInstance     = GetModuleHandleA(null);
        wc.hCursor       = LoadCursorA(0, (byte*)IDC_ARROW);
        wc.hbrBackground = 0;
        wc.lpszClassName = className.c_str();
        wc.cbWndExtra    = 8; // Reserve space for a pointer
        RegisterClassA(&wc);
    }

    void CreateHandle()
    {
        RegisterClass();

        hWnd = CreateWindowExA(
            GetWindowStyleEx(),
            className.c_str(),
            text.c_str(),       
            GetWindowStyle(),
            x, y, width, height,
            parent != null ? parent.GetHandle() : 0,                  
            0,                  
            GetModuleHandleA(null),
            this
        );
    }

    long GetHandle()
    {
        if(hWnd == 0)
            CreateHandle();
        return hWnd;
    }

    RECT get ClientRect()
    {
        GetClientRect(hWnd, &clientRect);
        return clientRect;
    }

    string toString()
    {
        return string.format("%s %s", getClassName(), name);
    }

    [Browsable(false)]
    array<BaseWindow> get Children() => children;

    string get Name() => name;
    void set Name(string value) => name = value;

    [PropertyEditor("ColorPropertyEditor")]
    uint get ForeColor() => foreColor;
    void set ForeColor(uint value)
    {
        foreColor = value;
        Invalidate();
    }

    [PropertyEditor("ColorPropertyEditor")]
    uint get BackColor() => backColor;
    void set BackColor(uint value)
    {
        backColor = value;
        backBrush = new Brush(backColor);
        Invalidate();
    }

    string get Text() => text;
    void set Text(string value)
    {
        text = value;
        SetWindowTextA(hWnd, text.c_str());
        OnTextChanged();
        Invalidate();
    }

    bool get Enabled() => enabled;
    void set Enabled(bool value)
    {
        enabled = value;
        if(value)
        {
            EnableWindow(hWnd, 1);
            OnEnabled();
            Invalidate();
        }
        else
        {
            OnDisabled();
            EnableWindow(hWnd, 0);
            Invalidate();
        }
    }

    virtual void OnVisibleChanged() {}

    bool get Visible() => visible;
    void set Visible(bool value)
    {
        visible = value;
        OnVisibleChanged();
        if(visible)
            ShowWindow(hWnd, SW_SHOW);
        else
            ShowWindow(hWnd, SW_HIDE);
    }

    int get Left() => x;
    void set Left(int value)
    {
        SetPosition(value, y);
    }

    int get Top() => y;
    void set Top(int value)
    {
        SetPosition(x, value);
    }

    int get Width() => width;
    void set Width(int value)
    {
        SetSize(value, height);
    }

    int get Height() => height;
    void set Height(int value)
    {
        SetSize(width, value);
    }

    [Browsable(false)]
    BaseWindow get Parent() => parent;
    void set Parent(BaseWindow value)
    {
        if(parent == value)
            return;

        if(parent != null)
           parent.children.remove(this);

        parent = value;
        SetParent(hWnd, parent != null ? parent.hWnd : 0);

        if(parent != null)
            parent.children.add(this);
    }

    void SetPosition(int x, int y)
    {
        SetWindowPos(GetHandle(), 0, x, y, 0, 0, SWP_NOSIZE | SWP_NOZORDER);
        this.x = x;
        this.y = y;
    }

    void SetSize(int w, int h)
    {
        SetWindowPos(GetHandle(), 0, x, y, w, h, SWP_NOZORDER);
        this.width = w;
        this.height = h;
    }

    void Show(int nCmdShow)
    {
        ShowWindow(GetHandle(), nCmdShow);
        visible = true;
    }

    void Invalidate()
    {
        InvalidateRect(hWnd, null, 1);
    }

    void Destroy()
    {
        DestroyWindow(hWnd);
        hWnd = 0;
    }

    BaseWindow GetChildByName(string name)
    {
        for(int i = 0; i < children.count; ++i)
        {
            if(children[i].name != null && children[i].name == name)
                return children[i];
            if(children.getClassType().HasAttribute("AcceptChildren"))
            {
                BaseWindow found = children[i].GetChildByName(name);
                if(found != null)
                    return found;
            }
        }
        return null;
    }

    Window GetTopLevelParent()
    {
        BaseWindow top = this;
        while(top.parent != null)
            top = top.parent;
        return top as Window;
    }

    virtual bool IsDesigner() => false;

    bool get DesignMode()
    {
        Window top = GetTopLevelParent();
        return top.IsDesigner();
    }

    virtual Control GetDesignerSelectedControl() => null;
    virtual void SetDesignerSelectedControl(Control control) { }
    virtual void DesignerRefreshProperties() {}
    virtual void DesignerControlDeleted(Control control) {}
    virtual PopupMenu DesignerGetCreateMenu(object target, void (*handler)(object, void*)) {}
    virtual void DesignerCreateControl(Window parent, string className, int x, int y) {}

    virtual void OnCreate() {}
    virtual void OnCreated() {}
    virtual bool OnClosing() { return true; }
    virtual void OnDestroy() {}
    virtual void OnTextChanged() {}

    virtual void OnSizeChanged() {}

    virtual void OnPaintBackground(Canvas canvas) 
    {
        RECT r = ClientRect;
        canvas.FillRectangle(0, 0, r.right, r.bottom, backBrush);
    }
    virtual void OnPaint(Canvas canvas) {}

    virtual void OnMouseMove(int x, int y) {}
    virtual void OnMouseDown(int button, int x, int y) {}
    virtual void OnMouseUp(int button, int x, int y) {}
    virtual void OnMouseWheel(int delta, int x, int y) {}
    virtual void OnMouseEnter() {}
    virtual void OnMouseLeave() {}

    virtual void OnEnabled() {}
    virtual void OnDisabled() {}

    virtual int OnKeyPreview(int key, int flags) { return 0; }
    virtual int OnKeyDown(int key, int flags) { return 0; }
    virtual int OnKeyUp(int key, int flags) { return 0; }
    virtual int OnChar(int ch) { return 0; }

    Bitmap memBmp = null;
    Canvas gfx = null;
    long memDC = 0;
    long oldBmp = 0;

    virtual long WndProc(long hwnd, uint uMsg, ulong wParam, ulong lParam)
    {
        if(uMsg == WM_CREATE)
        {
            OnCreate();
            PostMessageA(hwnd, WM_USER + 1, 0, 0);
        }
        else if(uMsg == WM_USER+1)
        {
            OnCreated();
        }
        else if(uMsg == WM_DESTROY)
        {
            OnDestroy();
            if(Window.hoverWindow == this)
                Window.hoverWindow = null;
            if(Window.activeWindow == this)
                Window.activeWindow = null;
            hWnd = 0;
        }
        else if(uMsg == WM_ERASEBKG)
        {
            if(!doubleBuffered)
            {
                Canvas canvas = new Canvas(wParam);
                OnPaintBackground(canvas);
            }
            return 1; // Prevent flickering by not erasing background
        }
        else if(uMsg == WM_MOVE)
        {
            this.x = (int)(short)(lParam & 0xFFFF);
            this.y = (int)(short)((lParam >> 16) & 0xFFFF);
        }
        else if(uMsg == WM_SIZE)
        {
            RECT cr;
            GetWindowRect(hwnd, &cr);
            width = cr.right - cr.left;
            height = cr.bottom - cr.top;
            //width = (int)(short)(lParam & 0xFFFF);
            //height = (int)(short)((lParam >> 16) & 0xFFFF);
            OnSizeChanged();
            Resize.invoke(this, null);
            Invalidate();
        }
        else if(uMsg == WM_PAINT)
        {
            PAINTSTRUCT ps = {};
            long hdc = BeginPaint(hwnd, &ps);
            Canvas canvas = new Canvas(hdc);
            Canvas paintCanvas = canvas;

            if(doubleBuffered)
            {
                if(memBmp == null || memBmp.width != width || memBmp.height != height)
                {
                    if(memDC)
                    {
                        SelectObject(memDC, oldBmp);
                        DeleteDC(memDC);
                    }
                    memBmp = Bitmap.FromSizeAndFormat(width, height, 24);
                    memDC = CreateCompatibleDC(canvas.hdc);
                    oldBmp = SelectObject(memDC, memBmp.hBitmap);
                    gfx = new Canvas(memDC);
                }
                paintCanvas = gfx;
                OnPaintBackground(paintCanvas);
            }

            OnPaint(paintCanvas);

            if(doubleBuffered)
            {
                BitBlt(canvas.hdc, 0, 0, width, height, gfx.hdc, 0, 0, SRCCOPY);
            }

            EndPaint(hwnd, &ps);
            return 0;
        }
        else if(uMsg == WM_MOUSEMOVE)
        {
            if(!DesignMode)
            {
                if(Window.hoverWindow != this)
                {
                    if(Window.hoverWindow != null)
                    {
                        Window.hoverWindow.OnMouseLeave();
                    }
                    Window.hoverWindow = this;
                    OnMouseEnter();
                }
            }

            int x = (int)(short)(lParam & 0xFFFF);
            int y = (int)(short)((lParam >> 16) & 0xFFFF);
            OnMouseMove(x, y);
        }
        else if(uMsg == WM_LBUTTONDOWN)
        {
            int x = (int)(short)(lParam & 0xFFFF);
            int y = (int)(short)((lParam >> 16) & 0xFFFF);
            OnMouseDown(1, x, y);
        }
        else if(uMsg == WM_LBUTTONUP)
        {
            int x = (int)(short)(lParam & 0xFFFF);
            int y = (int)(short)((lParam >> 16) & 0xFFFF);
            OnMouseUp(1, x, y);
        }
        else if(uMsg == WM_RBUTTONDOWN)
        {
            int x = (int)(short)(lParam & 0xFFFF);
            int y = (int)(short)((lParam >> 16) & 0xFFFF);
            OnMouseDown(2, x, y);
        }
        else if(uMsg == WM_RBUTTONUP)
        {
            int x = (int)(short)(lParam & 0xFFFF);
            int y = (int)(short)((lParam >> 16) & 0xFFFF);
            OnMouseUp(2, x, y);
        }
        else if(uMsg == WM_MOUSEWHEEL)
        {
            int delta = (int)(short)((wParam >> 16) & 0xFFFF);
            int x = (int)(short)(lParam & 0xFFFF);
            int y = (int)(short)((lParam >> 16) & 0xFFFF);
            if(delta > 0)
                OnMouseWheel(1, x, y);
            else if(delta < 0)
                OnMouseWheel(-1, x, y);
        }
        else if(uMsg == WM_USER_KEY_PREVIEW)
        {
            return OnKeyPreview(wParam, lParam);
        }
        else if(uMsg == WM_KEYDOWN)
        {
            return OnKeyDown(wParam, lParam);
        }
        else if(uMsg == WM_KEYUP)
        {
            return OnKeyUp(wParam, lParam);
        }
        else if(uMsg == WM_CHAR)
        {
            return OnChar(wParam);
        }
        return DefWindowProcA(hwnd, uMsg, wParam, lParam);
    }

    static long _WindowProc(long hwnd, uint uMsg, ulong wParam, ulong lParam)
    {
        BaseWindow *window = null;

        if(uMsg == WM_NCCREATE)
        {
            void* createParams = ((CREATESTRUCTA*)lParam).lpCreateParams;
            SetWindowLongPtrA(hwnd, 0, createParams);
            window = (BaseWindow*)createParams;
            window.hWnd = hwnd;

            if(window.GetWindowStyle() & WS_DLGFRAME)
            {
                long hUxTheme = LoadLibraryA("uxtheme.dll");
                long hUser32 = LoadLibraryA("user32.dll");
                int (*preferredAppMode)(int mode);
                int (*setWindowCompositionAttribute)(long hWnd, WINDOWCOMPOSITIONATTRIBDATA*);
                int (*allowDarkModeForWindow)(long hWnd, bool allow);

                preferredAppMode = GetProcAddress(hUxTheme, 135);
                allowDarkModeForWindow = GetProcAddress(hUxTheme, 133);
                setWindowCompositionAttribute = GetProcAddress(hUser32, "SetWindowCompositionAttribute");

                preferredAppMode(2);
                int res = allowDarkModeForWindow(hwnd, true);
                int value = 1;
                DwmSetWindowAttribute(hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, &value, sizeof(value));
                int dark = 1;
                WINDOWCOMPOSITIONATTRIBDATA data = { WINDOWCOMPOSITIONATTRIB.WCA_USEDARKMODECOLORS, &dark, sizeof(dark) };
                res = setWindowCompositionAttribute(hwnd, &data);
            }
        }
        else
        {
            long ptr = GetWindowLongPtrA(hwnd, 0);
            window = (BaseWindow*)ptr;
        }

        if(window != null)
        {
            return window.WndProc(hwnd, uMsg, wParam, lParam);
        }

        return DefWindowProcA(hwnd, uMsg, wParam, lParam);
    }    
}

class Window : BaseWindow
{
    Menu menu;
    Icon smallIcon;
    Icon bigIcon;
    static Window activeWindow = null;

    Window constructor()
    {
        base();
        return this;
    }

    void destructor()
    {
        base();
    }

    [Browsable(false)]
    Menu get Menu() => menu;
    void set Menu(Menu value)
    {
        menu = value;
        SetMenu(hWnd, menu != null ? menu.GetHandle() : 0);
        Invalidate();
        DrawMenuBar(hWnd);
    }

    Icon get SmallIcon() => smallIcon;
    void set SmallIcon(Icon value)
    {
        smallIcon = value;
        if(value != null)
            SendMessageA(hWnd, WM_SETICON, ICON_SMALL, smallIcon.hIcon);
        else
            SendMessageA(hWnd, WM_SETICON, ICON_SMALL, 0);
    }

    Icon get BigIcon() => bigIcon;
    void set BigIcon(Icon value)
    {
        bigIcon = value;
        if(value)
            SendMessageA(hWnd, WM_SETICON, ICON_BIG, bigIcon.hIcon);
        else
            SendMessageA(hWnd, WM_SETICON, ICON_BIG, 0);
    }

    void Close()
    {
        OnClose();
        Destroy();
    }

    virtual void OnClose() {}

    void DrawMenuBarLine(long hWnd)
    {
        MENUBARINFO mbi = {};
        mbi.cbSize = sizeof(MENUBARINFO);
        if(GetMenuBarInfo(hWnd, OBJID_MENU, 0, &mbi))
        {
            long hdc = GetWindowDC(hWnd);
            RECT rcWindow;
            GetWindowRect(hWnd, &rcWindow);
            RECT rc;
            rc.left = mbi.rcBar.left;
            rc.right = mbi.rcBar.right;
            rc.top = mbi.rcBar.bottom;
            rc.bottom = rc.top + 1;
            OffsetRect(&rc, -rcWindow.left, -rcWindow.top);
            FillRect(hdc, &rc, WindowDefaults.MenuBackBrush.hBrush);
            ReleaseDC(hWnd, hdc);
        }
    }

    virtual long WndProc(long hwnd, uint uMsg, ulong wParam, ulong lParam)
    {
        if(uMsg == WM_CLOSE)
        {
            if(OnClosing())
            {
                OnClose();
                Destroy();
                return 1;
            }
            else
            {
                return 0;
            }
        }
        else if(uMsg == WM_ACTIVATE)
        {
            if((wParam & 0xffff) == 0) // WA_INACTIVE
            {
                Log("Inactive %s", getClassName());
                       
            }
            else
            {
                Log("Active %s", getClassName());
                Window.activeWindow = this;
            }
            DrawMenuBarLine(hWnd);
        }
        else if(uMsg == WM_CTLCOLOREDIT)
        {
            long hdcEdit = wParam;

            SetTextColor(hdcEdit, WindowDefaults.TextboxForeColor);
            SetBkColor(hdcEdit, WindowDefaults.TextboxBackColor);

            return WindowDefaults.TextboxBackBrush.hBrush;
        }
        else if(uMsg == WM_UAHDRAWMENU)
        {
            UAHMENU* pUDM = (UAHMENU*)lParam;
            RECT rc = {};
            
            MENUBARINFO mbi = {};
            mbi.cbSize = sizeof(MENUBARINFO);
            GetMenuBarInfo(hWnd, OBJID_MENU, 0, &mbi);

            RECT rcWindow;
            GetWindowRect(hWnd, &rcWindow);
            rc = mbi.rcBar;
            OffsetRect(&rc, -rcWindow.left, -rcWindow.top);
            
            FillRect(pUDM.hdc, &rc, WindowDefaults.MenuBackBrush.hBrush);
            return 1;
        }
        else if(uMsg == WM_NCPAINT)
        {
            long result = DefWindowProcA(hwnd, uMsg, wParam, lParam);
            DrawMenuBarLine(hWnd);
            return result;
        }
        else if(uMsg == WM_UAHDRAWMENUITEM)
        {
            UAHDRAWMENUITEM* pUDMI = (UAHDRAWMENUITEM*)lParam;

            long brBackground = WindowDefaults.MenuBackBrush.hBrush;
            byte menuString[256];
            MENUITEMINFO mii;
            mii.cbSize = sizeof(mii);
            mii.fMask = MIIM_STRING;
            mii.dwTypeData = menuString;
            mii.cch = 255;
            GetMenuItemInfoA(pUDMI.um.hmenu, pUDMI.umi.iPosition, 1, &mii);

            uint dwFlags = DT_CENTER | DT_SINGLELINE | DT_VCENTER;

            if ((pUDMI.dis.itemState & ODS_SELECTED) != 0 || (pUDMI.dis.itemState & ODS_HOTLIGHT) != 0) 
            {
                brBackground = GetStockObject(DKGRAY_BRUSH);
            }   

            if (pUDMI.dis.itemState & ODS_NOACCEL) {
                dwFlags |= DT_HIDEPREFIX;
            }

            FillRect(pUDMI.um.hdc, &pUDMI.dis.rcItem, brBackground);
            SetTextColor(pUDMI.um.hdc, WindowDefaults.WindowForeColor);
            SetBkMode(pUDMI.um.hdc, TRANSPARENT);
            DrawTextA(pUDMI.um.hdc, menuString, mii.cch, &pUDMI.dis.rcItem, dwFlags);
            return 1;
        }
        else if(uMsg == WM_COMMAND)
        {
            uint commandId = wParam & 0xFFFF;
            if(menu != null && menu.HandleCommand(commandId))
                return 0;
        }
        return base(hwnd, uMsg, wParam, lParam);
    }

    void LoadLayout(string jsonText)
    {
        WindowJsonSerializer serializer = new WindowJsonSerializer(this);
        serializer.Deserialize(jsonText);
    }

    void LoadLayoutFromFile(string fileName)
    {
        LoadLayout(file.readAllText(fileName));
    }
}


class Dialog : Window
{
    int ModalResult = 0;

    uint GetWindowStyle()
    {
        return WS_POPUP | WS_CAPTION | WS_SYSMENU;
    }

    uint GetWindowStyleEx()
    {
        return WS_EX_DLGMODALFRAME;
    }

    void CenterWindow(long hwnd)
    {
        // Center the dialog on the monitor that contains the mouse cursor
        POINT pt = {};
        if(GetCursorPos(&pt))
        {
            long ptl = *(long*)&pt;
            long hMon = MonitorFromPoint(ptl, MONITOR_DEFAULTTONEAREST);
            if(hMon != 0)
            {
                MONITORINFO mi = {};
                mi.cbSize = sizeof(mi);
                if(GetMonitorInfoA(hMon, &mi))
                {
                    RECT wr = {};
                    GetWindowRect(hwnd, &wr);
                    int winW = wr.right - wr.left;
                    int winH = wr.bottom - wr.top;

                    int workW = mi.rcWork.right - mi.rcWork.left;
                    int workH = mi.rcWork.bottom - mi.rcWork.top;

                    int newX = mi.rcWork.left + (workW - winW) / 2;
                    int newY = mi.rcWork.top + (workH - winH) / 2;

                    SetPosition(newX, newY);
                }
            }
        }
    }

    void OnClose()
    {
        base();
        if(parent != null)
            EnableWindow(parent.hWnd, true);
    }

    int ShowDialog(Window owner)
    {
        MSG msg;
        bool done = false;

        if(owner != null)
        {
            parent = owner;

            EnableWindow(owner.hWnd, false);
        }

        // Ensure the window is created so we can size/position it
        long hwnd = GetHandle();

        CenterWindow(hwnd);

        ShowWindow(hwnd, SW_SHOW);

        while (!done && GetMessageA(&msg, null, 0, 0))
        {
            if (!IsDialogMessage(hWnd, &msg))
            {
                TranslateMessage(&msg);
                DispatchMessageA(&msg);
            }

            if (!IsWindow(hWnd))
                done = true;
        }

        /*if(owner != null)
        {
            // Re-enable the owner
            EnableWindow(owner.hWnd, true);
            SetForegroundWindow(owner.hWnd);
            SetActiveWindow(owner.hWnd);
            SetFocus(owner.hWnd);
        }*/

        return ModalResult;
    }    
}

class MsgDialog : Dialog
{
    string Title = "Error";
    string Message = "";
    MsgFlags Flags = MsgFlags.OK;

    void CreateButtons(int top, int width)
    {
        int buttons = Flags & 0x0f;

        if(buttons == MsgFlags.OK)
        {
            Button okButton = new Button(this, width-130, top, 100, 30);
            okButton.Text = "OK";
            okButton.ModalResult = 1;
        }
        else if(buttons == MsgFlags.OKCancel)
        {
            Button okButton = new Button(this, width-240, top, 100, 30);
            okButton.Text = "OK";
            okButton.ModalResult = 1;
            Button cancelButton = new Button(this, width-130, top, 100, 30);
            cancelButton.Text = "Cancel";
            cancelButton.ModalResult = 2;
        }
        else if(buttons == MsgFlags.YesNo)
        {
            Button okButton = new Button(this, width-240, top, 100, 30);
            okButton.Text = "Yes";
            okButton.ModalResult = 1;
            Button cancelButton = new Button(this, width-130, top, 100, 30);
            cancelButton.Text = "No";
            cancelButton.ModalResult = 2;
        }
        else if(buttons == MsgFlags.YesNoCancel)
        {
            Button noButton = new Button(this, width-350, top, 100, 30);
            noButton.Text = "Yes";
            noButton.ModalResult = 1;
            Button noButton = new Button(this, width-240, top, 100, 30);
            noButton.Text = "No";
            noButton.ModalResult = 2;
            Button cancelButton = new Button(this, width-130, top, 100, 30);
            cancelButton.Text = "Cancel";
            cancelButton.ModalResult = 3;
        }
    }

    void OnCreate()
    {
        if((Flags & 0xf0) != 0)
        {
            Picturebox picturebox = new Picturebox(this, 10, 10, 32, 32);
            picturebox.Border = false;
            if((Flags & MsgFlags.Info) != 0)
                picturebox.Image = WindowDefaults.InfoIcon;
            else if((Flags & MsgFlags.Question) != 0)
                picturebox.Image = WindowDefaults.QuestionIcon;
            else if((Flags & MsgFlags.Error) != 0)
                picturebox.Image = WindowDefaults.ErrorIcon;
        }

        Label label = new Label(this, (Flags & 0xf0) != 0 ? 52 : 10, 10, 200, 30);
        //label.Text = "Lorem ipsum dolor sit amet consectetur adipiscing elit dictumst, lacus curabitur nam litora sem erat platea, nec purus vestibulum commodo pulvinar porttitor vitae. Quisque nam malesuada vehicula dignissim cras congue, ante vestibulum nec pulvinar ultrices justo, ridiculus convallis facilisi diam mi. Suspendisse pharetra nisl quam ultrices cursus id, viverra cum ultricies arcu morbi habitant, primis duis rhoncus natoque mus, placerat nostra non facilisi sodales.\n\nProin turpis sociis quam massa sed cum lectus viverra tristique, orci dis et tempor fusce etiam enim quisque rhoncus, rutrum hac ullamcorper egestas quis justo pellentesque montes. Senectus vivamus tempus nullam sodales viverra bibendum tristique tempor fusce congue, gravida maecenas habitant faucibus egestas interdum laoreet luctus suspendisse pulvinar in, cum at elementum neque magnis tincidunt erat pretium eget. Duis facilisi accumsan ad vel enim nec eleifend dictum, massa ac fusce platea etiam luctus curabitur suspendisse, viverra eros posuere morbi penatibus non laoreet.";
        label.Text = Message;
        label.AutoSize = true;
        label.AutoSizeMaxWidth = 600;

        int minWidth = 300;
        if((Flags & 0x0f) == MsgFlags.YesNoCancel)
            minWidth = 450;

        int top = label.y + (label.height >? 32) + 10;
        int width = label.x + label.width + 20 >? minWidth;
        
        CreateButtons(top, width);
        
        int height = top + 80;
        SetSize(width, height);

        Text = Title;
    }
}

class WindowJsonSerializer : JsonSerializer
{
    Window window;

    WindowJsonSerializer constructor(Window window)
    {
        base();
        this.window = window;
        return this;
    }

    protected object CreateCustomInstance(object parent, string className, JsonObject jobj, array<string> ignoreList)
    {
        RTTIClassType cls = RTTIType.GetType(className) as RTTIClassType;
        if(cls == null)
            return null;

        if(cls.IsClassOf(typeof(Control)))
        {
            object (*ctor)(object, int, int, int, int) = cls.GetCreator().address;

            int x = (int) (jobj["Left"] as JsonNumber).value;
            int y = (int) (jobj["Top"] as JsonNumber).value;
            int w = (int) (jobj["Width"] as JsonNumber).value;
            int h = (int) (jobj["Height"] as JsonNumber).value;

            ignoreList.add("Left");
            ignoreList.add("Top");
            ignoreList.add("Width");
            ignoreList.add("Height");

            return ctor(parent, x, y, w, h);
        }
        else if(cls.IsClassOf(typeof(Window)))
        {
            return window;
        }

        return null;
    }

    protected bool DeserializeCustomProperty(object obj, RTTIProperty prop, JsonValue value)
    {
        if(obj.getClassType().IsClassOf(typeof(Window)) && prop.name == "Children")
        {
            JsonArray jarr = (JsonArray)value;

            for(int i = 0; i < jarr.count; ++i)
            {
                JsonValue elem = jarr[i];
                if(elem is JsonObject)
                {
                    object subObj = DeserializeObject(obj, elem as JsonObject);
                }
            }

            return true;
        }
        return false;
    }
}
