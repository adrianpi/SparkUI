const int MAPVK_VK_TO_VSC = 0;

struct MENUITEMINFO {
    uint      cbSize;
    uint      fMask;
    uint      fType;
    uint      fState;
    uint      wID;
    long      hSubMenu;
    long      hbmpChecked;
    long      hbmpUnchecked;
    void*     dwItemData;
    byte*     dwTypeData;
    uint      cch;
    long      hbmpItem;
}

