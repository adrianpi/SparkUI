using jargon;

[DefaultWidth(100)]
[DefaultHeight(20)]
class Dropdown : Control
{
    PopupWindow popup = null;
    Listbox listbox = null;
    ListItems Items = null;
    Event Clicked = new Event();
    bool dropping = false;

    uint GetWindowStyle()
    {
        return WS_CHILD | WS_VISIBLE | WS_TABSTOP;
    }

    [Browsable(false)]
    object get SelectedItem()
    {
        return listbox.SelectedItem;
    }

    void set SelectedItem(object value)
    {
        int index = Items.items.indexOf(value);
        if(index >= 0)
        {
            listbox.SelectedIndex = index;
            Text = value.toString();
        }
    }
    
    [Browsable(false)]
    int get SelectedIndex() => listbox.SelectedIndex;
    void set SelectedIndex(int value)
    {
        listbox.SelectedIndex = value;
        if(value >= 0 && value < Items.Count)
            Text = Items.items[value].toString();
    }

    Dropdown constructor(Window parent, int x, int y, int width, int height)
    {
        base(parent, x, y, width, height);        
        GetHandle();
        BackColor = 0x333333;

        popup = new PopupWindow(parent, 0, 0, width, 162);
        popup.Text = "Dropdown Popup";
        listbox = new Listbox(popup, 0, 0, width, 162);
        listbox.Leave += new Delegate(this, Dropdown.Listbox_OnLeave);
        Items = listbox.Items;
        listbox.Clicked += new Delegate(this, Dropdown.Listbox_Clicked);
        listbox.Confirmed += new Delegate(this, Dropdown.Listbox_Clicked);
        return this;
    }

    void RecreatePopup()
    {
        PopupWindow newPopup = new PopupWindow(parent, 0, 0, width, 162);
        newPopup.Text = "Dropdown Popup";
        Listbox newListbox = new Listbox(newPopup, 0, 0, width, 162);
        newListbox.Leave += new Delegate(this, Dropdown.Listbox_OnLeave);
        ListItems newItems = newListbox.Items;
        newListbox.Clicked += new Delegate(this, Dropdown.Listbox_Clicked);
        newListbox.Confirmed += new Delegate(this, Dropdown.Listbox_Clicked);

        for(int i = 0; i < Items.Count; ++i)
        {
            newItems.Add(Items.items[i]);
        }

        Items.Destroy();
        listbox.Destroy();
        popup.Destroy();

        popup = newPopup;
        listbox = newListbox;
        Items = newItems;
    }

    void OnDestroy()
    {
        popup.Destroy();
    }

    uint GetForeColor()
    {
        if(!Enabled)
            return WindowDefaults.WindowForeColorDisabled;
        else
            return ForeColor;
    }

    void OnPaint(Canvas canvas)
    {
        canvas.FillRectangle(0, 0, width, height, backBrush);
        canvas.DrawBitmap(width - 16, (height - 16) / 2, 16, 16, WindowDefaults.DropdownArrow);
        canvas.DrawText(2, 1, Text, this.Font, GetForeColor());
        if(HasFocus())
        {
            RECT fr = {0, 0, width, height};
            DrawFocusRect(canvas.hdc, &fr);
        }
    }

    void OnLeave()
    {
        if(!dropping)
            base();
        dropping = false;
    }

    void OnMouseDown(int button, int x, int y)
    {
        if(button == 1)
        {
            if(!popup.Visible)
            {
                dropping = true;
                POINT pt = {this.x, this.y + height};
                ClientToScreen(parent.hWnd, &pt);
                if(popup.parent != parent)
                {
                    // Cannot change ownership of a window. Recreate.
                    RecreatePopup();
                }
                popup.SetPosition(pt.x, pt.y);
                popup.Visible = true;
                int width = listbox.width;
                long dc = GetDC(hWnd);
                Canvas cv = new Canvas(dc);
                for(int i = 0; i < Items.Count; i++)
                {
                    SIZE ts = cv.MeasureText(Items.items[i].toString(), listbox.Font);
                    if(ts.cx + 20 > width)
                        width = ts.cx + 20;
                }
                ReleaseDC(hWnd, dc);
                listbox.SetSize(width, listbox.height);
                popup.SetSize(width, popup.height);
                if(Items.Count * 20 + 2 < 162)
                {
                    listbox.Items.topIndex = 0;
                    listbox.vscroll.Position = 0;
                    int cnt = Items.Count >? 1;
                    listbox.SetSize(listbox.width, cnt * 20+2);
                    popup.SetSize(popup.width, cnt * 20 + 2);
                }
                EnableWindow(popup.hWnd, true);
                listbox.Focus();
            }
            else
            {
                popup.Visible = false;  
                EnableWindow(popup.hWnd, false);
                Focus();
            }
        }
    }

    void OnVisibleChanged()
    {
        if(!Visible)
        {
            popup.Visible = false;
            EnableWindow(popup.hWnd, false);
        }
    }

    int OnKeyDown(int key, int flags)
    {
        if(key == VK_SPACE)
        {
            OnMouseDown(1, 0, 0);
            return 0;
        }
        return base(key, flags);
    }

    void Listbox_Clicked(object sender, void *param)
    {
        if(listbox.SelectedIndex >= 0)
        {
            Text = listbox.SelectedItem.toString();
            Clicked.invoke(this, null);
        }
        popup.Visible = false;
        EnableWindow(popup.hWnd, false);
        //DestroyWindow(popup.hWnd);
        SetActiveWindow(parent.hWnd);
        Focus();
    }

    void Listbox_OnLeave(object sender, void *param)
    {
        PostMessageA(hWnd, WM_USER+101, 0, 0);
    }

    long WndProc(long hwnd, uint uMsg, ulong wParam, ulong lParam)
    {
        if(uMsg == WM_USER+101)
        {
            popup.Visible = false;
            EnableWindow(popup.hWnd, false);
            SetActiveWindow(parent.hWnd);
            Focus();
        }
        else
        {
            return base(hwnd, uMsg, wParam, lParam);
        }
    }
}
