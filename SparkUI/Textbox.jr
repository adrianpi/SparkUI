using jargon;

const int ES_AUTOHSCROLL = 0x0080;

[DefaultWidth(100)]
[DefaultHeight(20)]
class Textbox : Control
{
    Event TextChanged = new Event();
    long originalWndProc = 0;

    Textbox constructor(Window parent, int x, int y, int width, int height)
    {
        base(parent, x, y, width, height);
        GetHandle();
        BackColor = 0x333333;
        SendMessageA(hWnd, WM_SETFONT, WindowDefaults.NormalTextFont.hFont, 0);

        // Store the instance pointer in GWLP_USERDATA for the subclassed proc
        SetWindowLongPtrA(hWnd, GWLP_USERDATA, this);

        // Subclass the EDIT control to intercept messages
        originalWndProc = GetWindowLongPtrA(hWnd, GWLP_WNDPROC);
        void* wp = Textbox._EditWndProc;
        SetWindowLongPtrA(hWnd, GWLP_WNDPROC, wp);

        return this;
    }

    void destructor()
    {
        // Restore the original window procedure when the Textbox is destroyed
        if(originalWndProc != 0)
        {
            SetWindowLongPtrA(hWnd, GWLP_WNDPROC, originalWndProc);
            originalWndProc = 0;
        }
        base();
    }

    string GetWindowClassName()
    {
        return "EDIT";
    }

    uint GetWindowStyle()
    {
        return WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_AUTOHSCROLL;
    }

    void RegisterClass()
    {
        className = GetWindowClassName();
    }

    void OnEnter()
    {
        base();
        SendMessageA(hWnd, 177/*EM_SETSEL*/, 0, -1); // Select all text when entering the textbox
    }

    void OnLeave()
    {
        byte *temp = (byte*)memory.alloc(1024);
        GetWindowTextA(hWnd, temp, 1024);
        string stemp = new string(temp);
        if(stemp != Text)
        {
            Text = stemp;
            TextChanged.invoke(this, null);
        }
        base();
    }

    static long _EditWndProc(long hwnd, uint uMsg, ulong wParam, ulong lParam)
    {
        // Get the Textbox instance from GWLP_USERDATA
        long ptr = GetWindowLongPtrA(hwnd, GWLP_USERDATA);
        Textbox* textbox = (Textbox*)ptr;

        if(textbox != null)
        {
            if(uMsg == WM_SETFOCUS)
            {
                textbox.OnEnter();
            }
            // Handle WM_KILLFOCUS to call OnLeave
            else if(uMsg == WM_KILLFOCUS)
            {
                textbox.OnLeave();
            }
            else if(uMsg == WM_MOVE)
            {
                textbox.x = (int)(short)(lParam & 0xFFFF);
                textbox.y = (int)(short)((lParam >> 16) & 0xFFFF);
                if(textbox.DesignMode)
                {
                    textbox.Invalidate();
                    textbox.GetTopLevelParent().DesignerRefreshProperties();
                }
            }
            else if(uMsg == WM_LBUTTONDOWN)
            {
                if(textbox.DesignMode)
                {
                    textbox.GetTopLevelParent().SetDesignerSelectedControl(textbox);
                    return 0;
                }
            }        
            else if(uMsg == WM_RBUTTONDOWN || uMsg == WM_NCRBUTTONDOWN)
            {
                if(textbox.DesignMode)
                {
                    //GetTopLevelParent().SetDesignerSelectedControl(this);
                    PopupMenu mnu = textbox.GetEditMenu();
                    POINT pt;
                    GetCursorPos(&pt);
                    ScreenToClient(textbox.GetTopLevelParent().hWnd, &pt);
                    mnu.Show(textbox.GetTopLevelParent(), pt.x, pt.y);
                    return 0;
                }
            }
            else if(uMsg == WM_NCLBUTTONDBLCLK)
            {
                return 0;
            }
            else if(uMsg == WM_NCHITTEST && textbox.GetTopLevelParent().GetDesignerSelectedControl() == textbox)
            {
                if(textbox.DesignMode)
                {
                    POINT pt;
                    pt.x = (int)(short)(lParam & 0xFFFF);
                    pt.y = (int)(short)((lParam >> 16) & 0xFFFF);
                    ScreenToClient(hwnd, &pt);
                    if(pt.x > textbox.Width - 4)
                        return HTRIGHT;
                    else if(pt.x < 4)
                        return HTLEFT;
                    else if(pt.y > textbox.Height - 4)
                        return HTBOTTOM;
                    else if(pt.y < 4)
                        return HTTOP;
                    else
                        return HTCAPTION;
                }
                //else
                //    return base(hwnd, uMsg, wParam, lParam);
            }
            else if(uMsg == WM_SIZE)
            {
                textbox.width = (int)(short)(lParam & 0xFFFF);
                textbox.height = (int)(short)((lParam >> 16) & 0xFFFF);

            }
            // Chain to original EDIT window procedure
            return CallWindowProcA(textbox.originalWndProc, hwnd, uMsg, wParam, lParam);
        }

        // Fallback if we don't have the instance
        return DefWindowProcA(hwnd, uMsg, wParam, lParam);
    }
}
